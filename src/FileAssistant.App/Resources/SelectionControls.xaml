<ResourceDictionary
    x:Class="FileAssistant.App.Resources.SelectionControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileAssistant.App.Controls">
    <!-- Selection and action dropdowns share button / popup metrics and semantic colors. -->
    <Thickness x:Key="SelectionDropDownPopupPadding">4</Thickness>
    <x:Double x:Key="SelectionDropDownPopupMinWidth">168</x:Double>
    <x:Double x:Key="SelectionDropDownMinHeight">32</x:Double>
    <Thickness x:Key="SelectionDropDownItemPadding">12,6</Thickness>
    <Thickness x:Key="SelectionDropDownItemMargin">0,1</Thickness>
    <controls:KeyboardFocusOpacityConverter x:Key="KeyboardFocusOpacityConverter" />
    <Style x:Key="SelectionDropDownButtonStyle" TargetType="DropDownButton">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinWidth" Value="128" />
        <Setter Property="MinHeight" Value="{StaticResource SelectionDropDownMinHeight}" />
    </Style>
    <Style x:Key="SelectionDropDownPresenterStyle" TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
        <Setter Property="Padding" Value="{StaticResource SelectionDropDownPopupPadding}" />
        <Setter Property="MinWidth" Value="{StaticResource SelectionDropDownPopupMinWidth}" />
        <Setter Property="Background" Value="{ThemeResource WorkspaceSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style x:Key="ActionDropDownPresenterStyle" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
        <Setter Property="Padding" Value="{StaticResource SelectionDropDownPopupPadding}" />
        <Setter Property="MinWidth" Value="{StaticResource SelectionDropDownPopupMinWidth}" />
        <Setter Property="Background" Value="{ThemeResource WorkspaceSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceBorderBrush}" />
    </Style>
    <Style x:Key="ActionDropDownSubItemStyle" TargetType="MenuFlyoutSubItem" BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}">
        <Setter Property="MinHeight" Value="{StaticResource SelectionDropDownMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource SelectionDropDownItemPadding}" />
        <Setter Property="Margin" Value="{StaticResource SelectionDropDownItemMargin}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>
    <Style x:Key="ActionDropDownItemStyle" TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
        <Setter Property="MinHeight" Value="{StaticResource SelectionDropDownMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource SelectionDropDownItemPadding}" />
        <Setter Property="Margin" Value="{StaticResource SelectionDropDownItemMargin}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuFlyoutItem">
                    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}" CornerRadius="{ThemeResource ControlCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource ComboBoxItemBackgroundPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource ComboBoxItemBackgroundPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Background="{ThemeResource ComboBoxItemBackgroundPointerOver}" CornerRadius="{ThemeResource ControlCornerRadius}"
                            IsHitTestVisible="False" Opacity="{Binding FocusState, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource KeyboardFocusOpacityConverter}}" />
                        <TextBlock x:Name="TextBlock" Text="{TemplateBinding Text}" Margin="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SelectionDropDownListStyle" TargetType="ListView">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MaxHeight" Value="400" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <DataTemplate x:Key="SelectionDropDownItemTemplate" x:DataType="controls:SelectionOption">
        <TextBlock Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
    <Style x:Key="SelectionDropDownItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="MinHeight" Value="{StaticResource SelectionDropDownMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource SelectionDropDownItemPadding}" />
        <Setter Property="Margin" Value="{StaticResource SelectionDropDownItemMargin}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ListViewItemPresenter
                        Control.IsTemplateFocusTarget="True"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        ContentMargin="{TemplateBinding Padding}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                        FocusVisualPrimaryBrush="{TemplateBinding FocusVisualPrimaryBrush}"
                        FocusVisualPrimaryThickness="{TemplateBinding FocusVisualPrimaryThickness}"
                        FocusVisualSecondaryBrush="{TemplateBinding FocusVisualSecondaryBrush}"
                        FocusVisualSecondaryThickness="{TemplateBinding FocusVisualSecondaryThickness}"
                        PointerOverBackground="{ThemeResource ComboBoxItemBackgroundPointerOver}"
                        PointerOverForeground="{ThemeResource ComboBoxItemForegroundPointerOver}"
                        PressedBackground="{ThemeResource ComboBoxItemBackgroundPressed}"
                        SelectedBackground="{ThemeResource ComboBoxItemBackgroundSelected}"
                        SelectedForeground="{ThemeResource ComboBoxItemForegroundSelected}"
                        SelectedPointerOverBackground="{ThemeResource ComboBoxItemBackgroundSelectedPointerOver}"
                        SelectedPressedBackground="{ThemeResource ComboBoxItemBackgroundSelectedPressed}"
                        SelectedDisabledBackground="{ThemeResource ComboBoxItemBackgroundSelectedDisabled}"
                        DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                        SelectionCheckMarkVisualEnabled="False"
                        SelectionIndicatorVisualEnabled="True"
                        SelectionIndicatorCornerRadius="{ThemeResource ListViewItemSelectionIndicatorCornerRadius}"
                        SelectionIndicatorBrush="{ThemeResource SelectionIndicatorBrush}"
                        SelectionIndicatorPointerOverBrush="{ThemeResource SelectionIndicatorBrush}"
                        SelectionIndicatorPressedBrush="{ThemeResource SelectionIndicatorBrush}"
                        SelectionIndicatorDisabledBrush="{ThemeResource ListViewItemSelectionIndicatorDisabledBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
