<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SelectionIndicatorBrush" Color="{ThemeResource AppAccentColor}" />
            <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="WorkspaceSurfaceBrush" Color="{ThemeResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="WorkspaceSubtleBrush" Color="{ThemeResource AppSubtleColor}" />
            <SolidColorBrush x:Key="WorkspaceBorderBrush" Color="{ThemeResource AppBorderColor}" />
            <SolidColorBrush x:Key="WorkspaceSecondaryBrush" Color="{ThemeResource AppSecondaryTextColor}" />
            <SolidColorBrush x:Key="WorkspaceAccentBrush" Color="{ThemeResource AppAccentColor}" />
            <SolidColorBrush x:Key="WorkspaceAccentSubtleBrush" Color="{ThemeResource AppAccentSubtleColor}" />
            <SolidColorBrush x:Key="WorkspaceSuccessBrush" Color="{ThemeResource AppSuccessColor}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource AppAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource AppAccentSecondaryColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource AppAccentTertiaryColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource AppAccentColor}" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource AppAccentColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource AppAccentSubtleColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource AppSelectionHoverColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SelectionIndicatorBrush" Color="{ThemeResource AppAccentColor}" />
            <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="WorkspaceSurfaceBrush" Color="{ThemeResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="WorkspaceSubtleBrush" Color="{ThemeResource AppSubtleColor}" />
            <SolidColorBrush x:Key="WorkspaceBorderBrush" Color="{ThemeResource AppBorderColor}" />
            <SolidColorBrush x:Key="WorkspaceSecondaryBrush" Color="{ThemeResource AppSecondaryTextColor}" />
            <SolidColorBrush x:Key="WorkspaceAccentBrush" Color="{ThemeResource AppAccentColor}" />
            <SolidColorBrush x:Key="WorkspaceAccentSubtleBrush" Color="{ThemeResource AppAccentSubtleColor}" />
            <SolidColorBrush x:Key="WorkspaceSuccessBrush" Color="{ThemeResource AppSuccessColor}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource AppAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource AppAccentSecondaryColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource AppAccentTertiaryColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource AppAccentColor}" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource AppAccentColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource AppAccentSubtleColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource AppSelectionHoverColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SelectionIndicatorBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="WorkspaceSurfaceBrush" Color="{ThemeResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="WorkspaceSubtleBrush" Color="{ThemeResource AppSubtleColor}" />
            <SolidColorBrush x:Key="WorkspaceBorderBrush" Color="{ThemeResource AppBorderColor}" />
            <SolidColorBrush x:Key="WorkspaceSecondaryBrush" Color="{ThemeResource AppSecondaryTextColor}" />
            <SolidColorBrush x:Key="WorkspaceAccentBrush" Color="{ThemeResource AppAccentColor}" />
            <SolidColorBrush x:Key="WorkspaceAccentSubtleBrush" Color="{ThemeResource AppAccentSubtleColor}" />
            <SolidColorBrush x:Key="WorkspaceSuccessBrush" Color="{ThemeResource AppSuccessColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="WorkspaceCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource WorkspaceSecondaryBrush}" />
    </Style>
    <Style x:Key="WorkspaceSectionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="WorkspaceListItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
</ResourceDictionary>
