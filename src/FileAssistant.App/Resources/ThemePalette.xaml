<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Defaults: Light = approved concept 15; Dark = approved concept 14.
         Single color source. Keep Light/Dark/HighContrast keys paired; pages use semantic brushes. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#292E25</Color>
            <Color x:Key="SystemAccentColorLight1">#707A64</Color>
            <Color x:Key="SystemAccentColorLight2">#DADCD1</Color>
            <Color x:Key="SystemAccentColorLight3">#E8EADF</Color>
            <Color x:Key="SystemAccentColorDark1">#23281F</Color>
            <Color x:Key="SystemAccentColorDark2">#1D221A</Color>
            <Color x:Key="SystemAccentColorDark3">#151A12</Color>
            <Color x:Key="AppBackgroundColor">#EAE8E2</Color>
            <Color x:Key="AppSurfaceColor">#FAFAF6</Color>
            <Color x:Key="AppSubtleColor">#F1F0EA</Color>
            <Color x:Key="AppBorderColor">#DCDDD3</Color>
            <Color x:Key="AppTextColor">#252620</Color>
            <Color x:Key="AppSecondaryTextColor">#707268</Color>
            <Color x:Key="AppAccentColor">#292E25</Color>
            <Color x:Key="AppAccentSecondaryColor">#3B4235</Color>
            <Color x:Key="AppAccentTertiaryColor">#1D221A</Color>
            <Color x:Key="AppAccentSubtleColor">#E1E3D8</Color>
            <Color x:Key="AppSelectionHoverColor">#DADCD1</Color>
            <Color x:Key="AppOnAccentColor">#FAFAF6</Color>
            <Color x:Key="AppAccentTextColor">#292E25</Color>
            <Color x:Key="AppSuccessColor">#287046</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#C94B46</Color>
            <Color x:Key="SystemAccentColorLight1">#DF625B</Color>
            <Color x:Key="SystemAccentColorLight2">#EF6B63</Color>
            <Color x:Key="SystemAccentColorLight3">#F6AAA5</Color>
            <Color x:Key="SystemAccentColorDark1">#BC443F</Color>
            <Color x:Key="SystemAccentColorDark2">#AD3C37</Color>
            <Color x:Key="SystemAccentColorDark3">#90312D</Color>
            <Color x:Key="AppBackgroundColor">#151517</Color>
            <Color x:Key="AppSurfaceColor">#232327</Color>
            <Color x:Key="AppSubtleColor">#202024</Color>
            <Color x:Key="AppBorderColor">#34343B</Color>
            <Color x:Key="AppTextColor">#F0F0F2</Color>
            <Color x:Key="AppSecondaryTextColor">#B0B0BA</Color>
            <Color x:Key="AppAccentColor">#C94B46</Color>
            <Color x:Key="AppAccentSecondaryColor">#BC443F</Color>
            <Color x:Key="AppAccentTertiaryColor">#AD3C37</Color>
            <Color x:Key="AppAccentSubtleColor">#323237</Color>
            <Color x:Key="AppSelectionHoverColor">#3D3D44</Color>
            <Color x:Key="AppOnAccentColor">#FFFFFF</Color>
            <Color x:Key="AppAccentTextColor">#EF6B63</Color>
            <Color x:Key="AppSuccessColor">#8CD8AC</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="SystemAccentColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="SystemAccentColorLight1" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="SystemAccentColorLight2" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="SystemAccentColorLight3" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="SystemAccentColorDark1" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="SystemAccentColorDark2" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="SystemAccentColorDark3" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AppBackgroundColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="AppSurfaceColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="AppSubtleColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="AppBorderColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="AppTextColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="AppSecondaryTextColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="AppAccentColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AppAccentSecondaryColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AppAccentTertiaryColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AppAccentSubtleColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AppSelectionHoverColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AppOnAccentColor" ResourceKey="SystemColorHighlightTextColor" />
            <StaticResource x:Key="AppAccentTextColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AppSuccessColor" ResourceKey="SystemColorWindowTextColor" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
