<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Single color source. Keep Light/Dark/HighContrast keys paired; pages use semantic brushes. -->
    <Color x:Key="SystemAccentColor">#242728</Color>
    <Color x:Key="SystemAccentColorLight1">#AEB8A9</Color>
    <Color x:Key="SystemAccentColorLight2">#D9E1D4</Color>
    <Color x:Key="SystemAccentColorLight3">#ECEEE8</Color>
    <Color x:Key="SystemAccentColorDark1">#242728</Color>
    <Color x:Key="SystemAccentColorDark2">#1E221F</Color>
    <Color x:Key="SystemAccentColorDark3">#151916</Color>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppBackgroundColor">#F2F3EF</Color>
            <Color x:Key="AppSurfaceColor">#FFFFFF</Color>
            <Color x:Key="AppSubtleColor">#FAFAF8</Color>
            <Color x:Key="AppBorderColor">#E2E5DD</Color>
            <Color x:Key="AppTextColor">#252627</Color>
            <Color x:Key="AppSecondaryTextColor">#62685F</Color>
            <Color x:Key="AppAccentColor">#242728</Color>
            <Color x:Key="AppAccentSecondaryColor">#3B403D</Color>
            <Color x:Key="AppAccentTertiaryColor">#171B18</Color>
            <Color x:Key="AppAccentSubtleColor">#ECEEE8</Color>
            <Color x:Key="AppSelectionHoverColor">#E4E7DF</Color>
            <Color x:Key="AppOnAccentColor">#FFFFFF</Color>
            <Color x:Key="AppSuccessColor">#18703F</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppBackgroundColor">#1C201E</Color>
            <Color x:Key="AppSurfaceColor">#252A27</Color>
            <Color x:Key="AppSubtleColor">#212623</Color>
            <Color x:Key="AppBorderColor">#3D453F</Color>
            <Color x:Key="AppTextColor">#EEF1EB</Color>
            <Color x:Key="AppSecondaryTextColor">#B5BDB4</Color>
            <Color x:Key="AppAccentColor">#D9E1D4</Color>
            <Color x:Key="AppAccentSecondaryColor">#E3EADF</Color>
            <Color x:Key="AppAccentTertiaryColor">#C8D2C3</Color>
            <Color x:Key="AppAccentSubtleColor">#363E36</Color>
            <Color x:Key="AppSelectionHoverColor">#414A41</Color>
            <Color x:Key="AppOnAccentColor">#202421</Color>
            <Color x:Key="AppSuccessColor">#8CD8AC</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="AppBackgroundColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="AppSurfaceColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="AppSubtleColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="AppBorderColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="AppTextColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="AppSecondaryTextColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="AppAccentColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AppAccentSecondaryColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AppAccentTertiaryColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AppAccentSubtleColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AppSelectionHoverColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AppOnAccentColor" ResourceKey="SystemColorHighlightTextColor" />
            <StaticResource x:Key="AppSuccessColor" ResourceKey="SystemColorWindowTextColor" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
