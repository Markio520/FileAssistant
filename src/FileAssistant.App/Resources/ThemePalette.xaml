<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The app's color values live here. Controls consume semantic ThemeResource brushes. -->
    <Color x:Key="SystemAccentColor">#007D82</Color>
    <Color x:Key="SystemAccentColorLight1">#5CB8BF</Color>
    <Color x:Key="SystemAccentColorLight2">#83D5D7</Color>
    <Color x:Key="SystemAccentColorLight3">#C4ECEE</Color>
    <Color x:Key="SystemAccentColorDark1">#006C70</Color>
    <Color x:Key="SystemAccentColorDark2">#005A60</Color>
    <Color x:Key="SystemAccentColorDark3">#003F44</Color>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppBackgroundColor">#F3F5F7</Color>
            <Color x:Key="AppSurfaceColor">#FFFFFF</Color>
            <Color x:Key="AppSubtleColor">#F7F9FA</Color>
            <Color x:Key="AppBorderColor">#DEE4E8</Color>
            <Color x:Key="AppSecondaryTextColor">#56636F</Color>
            <StaticResource x:Key="AppAccentColor" ResourceKey="SystemAccentColorDark1" />
            <Color x:Key="AppAccentSecondaryColor">#087C80</Color>
            <Color x:Key="AppAccentTertiaryColor">#146367</Color>
            <Color x:Key="AppAccentSubtleColor">#E5F2F2</Color>
            <Color x:Key="AppSelectionHoverColor">#D7EAEB</Color>
            <Color x:Key="AppSuccessColor">#18703F</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppBackgroundColor">#1B2025</Color>
            <Color x:Key="AppSurfaceColor">#252C32</Color>
            <Color x:Key="AppSubtleColor">#20272D</Color>
            <Color x:Key="AppBorderColor">#3A444D</Color>
            <Color x:Key="AppSecondaryTextColor">#B6C1CB</Color>
            <StaticResource x:Key="AppAccentColor" ResourceKey="SystemAccentColorLight2" />
            <Color x:Key="AppAccentSecondaryColor">#99DFE0</Color>
            <Color x:Key="AppAccentTertiaryColor">#6FC2C5</Color>
            <Color x:Key="AppAccentSubtleColor">#234345</Color>
            <Color x:Key="AppSelectionHoverColor">#2C5153</Color>
            <Color x:Key="AppSuccessColor">#8CD8AC</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="AppBackgroundColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="AppSurfaceColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="AppSubtleColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="AppBorderColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="AppSecondaryTextColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="AppAccentColor" ResourceKey="SystemColorHotlightColor" />
            <StaticResource x:Key="AppAccentSubtleColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="AppSuccessColor" ResourceKey="SystemColorWindowTextColor" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
