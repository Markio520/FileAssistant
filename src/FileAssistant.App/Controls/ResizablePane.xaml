<UserControl
    x:Class="FileAssistant.App.Controls.ResizablePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileAssistant.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="HandleColumn" Width="8" />
            <ColumnDefinition x:Name="PaneColumn" Width="304" />
        </Grid.ColumnDefinitions>
        <ContentPresenter Content="{x:Bind MainContent, Mode=OneWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <controls:ResizeHandle x:Name="Handle" Grid.Column="1" ResizeRequested="Pane_ResizeRequested"
            AutomationProperties.Name="调整侧栏宽度" ToolTipService.ToolTip="拖动或用左右方向键调整侧栏宽度" />
        <ContentPresenter x:Name="PanePresenter" Grid.Column="2" Content="{x:Bind PaneContent, Mode=OneWay}"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</UserControl>
