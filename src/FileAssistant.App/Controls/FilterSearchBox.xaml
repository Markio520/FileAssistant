<UserControl
    x:Class="FileAssistant.App.Controls.FilterSearchBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileAssistant.App.Controls"
    MinWidth="260">
    <Grid>
        <Grid.Resources>
            <!-- The outer frame owns the border; native input and dropdown behavior stay intact. -->
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        </Grid.Resources>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused" />
                <VisualState x:Name="Focused">
                    <VisualState.Setters>
                        <Setter Target="Frame.BorderBrush" Value="{ThemeResource WorkspaceAccentBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="Frame" Background="{ThemeResource WorkspaceSurfaceBrush}"
            BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:SelectionDropDown ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                    SelectedValue="{x:Bind SelectedValue, Mode=TwoWay}"
                    MinWidth="104" MinHeight="32" Padding="12,5" BorderThickness="0"
                    CornerRadius="5,0,0,5" Background="Transparent" FontSize="12"
                    AutomationProperties.Name="文件类型筛选" />
                <Border Grid.Column="1" Height="18" Background="{ThemeResource WorkspaceBorderBrush}" />
                <AutoSuggestBox x:Name="QueryInput" Grid.Column="2" MinWidth="0" MinHeight="32"
                    VerticalContentAlignment="Center"
                    BorderThickness="0" CornerRadius="0,5,5,0" Background="Transparent" FontSize="12"
                    PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}" QueryIcon="Find"
                    Text="{x:Bind Text, Mode=TwoWay}" TextChanged="Query_TextChanged"
                    GotFocus="Query_GotFocus" LostFocus="Query_LostFocus"
                    AutomationProperties.Name="搜索当前文件列表" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
