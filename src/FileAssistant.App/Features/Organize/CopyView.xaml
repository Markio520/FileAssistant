<UserControl x:Class="FileAssistant.App.Features.Organize.CopyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:input="using:FileAssistant.App.Features.FileInput" xmlns:local="using:FileAssistant.App.Features.Organize">
    <input:FileInputView x:Name="InputView" ViewModel="{x:Bind ViewModel.Input}" SearchRequested="Input_SearchRequested" FilesForCopyRequested="Input_FilesForCopyRequested" FilesForConversionRequested="Input_FilesForConversionRequested">
        <input:FileInputView.OperationContent><local:CopyOptionsView x:Name="OptionsPanel" /></input:FileInputView.OperationContent>
    </input:FileInputView>
</UserControl>
