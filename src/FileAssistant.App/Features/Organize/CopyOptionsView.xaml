<UserControl x:Class="FileAssistant.App.Features.Organize.CopyOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileAssistant.App.Controls" xmlns:copy="using:FileAssistant.Core.Features.Organize">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="20,16,20,18">
                <StackPanel Spacing="8">
                    <TextBlock Text="复制到" FontSize="14" FontWeight="SemiBold" />
                    <TextBox Text="{x:Bind ViewModel.Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="选择或填写目标目录" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.Name="复制目标目录" />
                    <Button Content="选择目标目录…" Click="PickDestination_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="目录整理" FontSize="13" FontWeight="SemiBold" />
                    <controls:SelectionDropDown ItemsSource="{x:Bind ViewModel.Layouts}" SelectedValue="{x:Bind ViewModel.LayoutValue, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="复制目录整理方式" />
                    <TextBlock Text="保留结构以所选磁盘文件夹为根，包含空目录。软件文件夹用于确定输入范围。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="遇到同名文件" FontSize="13" FontWeight="SemiBold" />
                    <controls:SelectionDropDown ItemsSource="{x:Bind ViewModel.Conflicts}" SelectedValue="{x:Bind ViewModel.ConflictValue, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="复制同名处理方式" />
                </StackPanel>
                <Expander Header="复制计划" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.PlanSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.BuildPlanCommand}" Style="{StaticResource WorkspaceIconButtonStyle}" AutomationProperties.Name="刷新复制计划" ToolTipService.ToolTip="重新扫描文件和目标路径"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button>
                        </Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.Plan.Items, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedPlanItem, Mode=TwoWay}" SelectionMode="Single" MaxHeight="180" Padding="0" AutomationProperties.Name="复制计划项目">
                            <ListView.ItemTemplate><DataTemplate x:DataType="copy:CopyPlanItem">
                                <TextBlock Text="{x:Bind Description}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Paths}" />
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="{x:Bind ViewModel.SelectedPlanItem.Paths, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasDecision, Mode=OneWay}">
                            <Button Content="编号保留两个文件" Tag="Number" Click="Decide_Click" HorizontalAlignment="Stretch" />
                            <Button Content="跳过此项" Tag="Skip" Click="Decide_Click" HorizontalAlignment="Stretch" />
                            <Button Content="确认覆盖并保留备份" Tag="Overwrite" Click="Decide_Click" IsEnabled="{x:Bind ViewModel.CanApproveOverwrite, Mode=OneWay}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
                <TextBlock Text="{x:Bind ViewModel.Feedback, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                    <ProgressBar Value="{x:Bind ViewModel.ActiveJob.Progress, Mode=OneWay}" Maximum="100" AutomationProperties.Name="复制字节进度" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveJob.Status, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
                <Expander Header="本次结果" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.Report.Summary, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" />
                        <ListView ItemsSource="{x:Bind ViewModel.Report.Items, Mode=OneWay}" MaxHeight="240" SelectionMode="None" Padding="0" AutomationProperties.Name="复制结果明细">
                            <ListView.ItemTemplate><DataTemplate x:DataType="copy:CopyItemResult"><TextBlock Text="{x:Bind Description}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <Button Content="重新检查未完成项" Command="{x:Bind ViewModel.RetryCommand}" HorizontalAlignment="Stretch" />
                        <Button Content="查看输出" Command="{x:Bind ViewModel.ShowOutputsCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Expander>
                <Expander Header="覆盖恢复" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="备份跨重启保留。恢复前检查当前目标；删除备份需要确认。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                        <Button Content="刷新恢复记录" Command="{x:Bind ViewModel.RefreshRecoveriesCommand}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="暂无覆盖备份。" Visibility="{x:Bind ViewModel.NoRecoveries, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                        <ListView x:Name="RecoveryList" ItemsSource="{x:Bind ViewModel.Recoveries, Mode=OneWay}" MaxHeight="220" SelectionMode="Single" Padding="0" AutomationProperties.Name="覆盖恢复记录">
                            <ListView.ItemTemplate><DataTemplate x:DataType="copy:CopyRecovery"><TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" FontSize="12" /></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <Button Content="恢复所选旧目标" Click="Restore_Click" IsEnabled="{x:Bind ViewModel.CanRecover, Mode=OneWay}" HorizontalAlignment="Stretch" />
                        <Button Content="删除所选备份…" Click="Discard_Click" IsEnabled="{x:Bind ViewModel.CanRecover, Mode=OneWay}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Padding="20,12,20,16" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.ScopeSummary, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />
                <Button Content="清除全部勾选" Command="{x:Bind ViewModel.ClearSelectionCommand}" Visibility="{x:Bind ViewModel.Input.HasSelection, Mode=OneWay}" HorizontalAlignment="Stretch" />
                <Button Content="开始复制" Command="{x:Bind ViewModel.RunCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                <Button Content="取消" Command="{x:Bind ViewModel.CancelCommand}" Visibility="{x:Bind ViewModel.CanCancel, Mode=OneWay}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
