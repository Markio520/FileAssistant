<UserControl x:Class="FileAssistant.App.Features.Convert.ConversionOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileAssistant.App.Features.Convert" xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:preview="using:FileAssistant.App.Features.Preview" xmlns:engines="using:FileAssistant.Core.Engines">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="20,16,20,18">
                <StackPanel Spacing="8">
                    <TextBlock Text="文件预览" FontSize="11" FontWeight="SemiBold" />
                    <preview:FilePreviewView PreviewHeight="128" File="{x:Bind ViewModel.Input.PreviewFile, Mode=OneWay}" Glyph="{x:Bind ViewModel.Input.PreviewGlyph, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Input.PreviewName, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.Input.PreviewPath, Mode=OneWay}" />
                    <TextBlock Visibility="{x:Bind ViewModel.Input.HasPreviewStatus, Mode=OneWay}" Text="{x:Bind ViewModel.Input.PreviewStatus, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                </StackPanel>
                <Border Height="1" Background="{ThemeResource WorkspaceBorderBrush}" />
                <StackPanel Spacing="8">
                    <TextBlock Text="输出格式" FontSize="11" FontWeight="SemiBold" />
                    <controls:SelectionDropDown ItemsSource="{x:Bind ViewModel.Formats, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.TargetFormatValue, Mode=TwoWay}"
                        ButtonContent="{x:Bind ViewModel.FormatButtonContent, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanSelectFormat, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="转换输出格式" />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasFormatError, Mode=OneWay}" IsClosable="False" Severity="Warning" Message="{x:Bind ViewModel.FormatFeedback, Mode=OneWay}" />
                    <Button Content="前往引擎管理" Command="{x:Bind ViewModel.OpenEngineManagementCommand}" Visibility="{x:Bind ViewModel.HasMissingEngine, Mode=OneWay}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowQuality, Mode=OneWay}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="图片质量" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3"><TextBlock Text="{x:Bind ViewModel.Quality, Mode=OneWay}" FontSize="11" /><TextBlock Text="%" FontSize="11" /></StackPanel>
                    </Grid>
                    <Slider Minimum="1" Maximum="100" StepFrequency="1" Value="{x:Bind ViewModel.Quality, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.Name="图片质量" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="文件更小" FontSize="10" Foreground="{ThemeResource WorkspaceSecondaryBrush}" /><TextBlock Grid.Column="1" Text="画质更高" FontSize="10" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                    </Grid>
                </StackPanel>
                <NumberBox Header="最长边（px，0 为原尺寸）" Minimum="0" Maximum="16384" Value="{x:Bind ViewModel.MaximumEdge, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowSize, Mode=OneWay}" SpinButtonPlacementMode="Compact" />
                <Expander Header="转换计划" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="展开或隐藏转换计划">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.PlanSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.BuildPlanCommand}" Style="{StaticResource WorkspaceIconButtonStyle}" AutomationProperties.Name="刷新转换计划" ToolTipService.ToolTip="重新检查文件和输出路径"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button>
                        </Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.Plan.Items, Mode=OneWay}" SelectionMode="None" MaxHeight="144" Padding="0" IsItemClickEnabled="False" AutomationProperties.Name="转换计划明细">
                            <ListView.ItemTemplate><DataTemplate x:DataType="engines:ConversionPlanItem">
                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" FontSize="11" Margin="0,4" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind OutputPath}" />
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>
                <StackPanel Spacing="8">
                    <TextBlock Text="保存到" FontSize="11" FontWeight="SemiBold" />
                    <TextBox Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" AutomationProperties.Name="转换输出文件夹" />
                    <Button Content="选择输出文件夹…" Click="PickOutput_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalAlignment="Stretch" FontSize="12" />
                </StackPanel>
                <Expander Header="更多参数与说明" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                    <TextBlock Text="处理模式" FontSize="11" FontWeight="SemiBold" />
                    <controls:SelectionDropDown ItemsSource="{x:Bind ViewModel.Modes}" SelectedValue="{x:Bind ViewModel.ModeValue, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="转换处理模式" />
                    <controls:SelectionDropDown ItemsSource="{x:Bind ViewModel.Presets}" SelectedValue="{x:Bind ViewModel.PresetValue, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowProcessing, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="压缩预设" />
                <StackPanel Spacing="12">
            <NumberBox Header="PDF 导出分辨率（DPI）" Minimum="72" Maximum="600" Value="{x:Bind ViewModel.PdfDpi, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowPdfDpi, Mode=OneWay}" SpinButtonPlacementMode="Compact" />
            <ContentControl IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8">

                <NumberBox Header="音轨序号（从 1 开始）" Minimum="1" Value="{x:Bind ViewModel.AudioTrack, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowMedia, Mode=OneWay}" SpinButtonPlacementMode="Compact" />
                <NumberBox Header="音频码率（kbps）" Minimum="32" Maximum="320" Value="{x:Bind ViewModel.AudioBitrate, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowAudioBitrate, Mode=OneWay}" SpinButtonPlacementMode="Compact" />
                <NumberBox Header="视频码率（kbps）" Minimum="100" Maximum="100000" Value="{x:Bind ViewModel.VideoBitrate, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowVideo, Mode=OneWay}" SpinButtonPlacementMode="Compact" />
                <controls:SelectionDropDown ItemsSource="{x:Bind ViewModel.SampleRates}" SelectedValue="{x:Bind ViewModel.SampleRate, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowSampleRate, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="音频采样率" />
                <CheckBox Content="TIFF 处理全部页面" IsChecked="{x:Bind ViewModel.AllTiffPages, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowTiffPages, Mode=OneWay}" />
                <NumberBox Header="静态图帧 / 页（从 1 开始）" Minimum="1" Value="{x:Bind ViewModel.Frame, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowFrame, Mode=OneWay}" SpinButtonPlacementMode="Compact" />
                <StackPanel Visibility="{x:Bind ViewModel.ShowDelimited, Mode=OneWay}" Spacing="6">
                    <TextBlock Text="CSV / TSV 编码" />
                    <controls:SelectionDropDown ItemsSource="{x:Bind ViewModel.Encodings}" SelectedValue="{x:Bind ViewModel.EncodingValue, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="表格文本编码" />
                    <TextBlock Text="CSV 分隔符（TSV 固定 Tab）" Visibility="{x:Bind ViewModel.ShowSeparator, Mode=OneWay}" />
                    <controls:SelectionDropDown ItemsSource="{x:Bind ViewModel.Separators}" SelectedValue="{x:Bind ViewModel.SeparatorValue, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowSeparator, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="CSV 分隔符" />
                    <CheckBox Content="导入时将等号开头内容作为公式" IsChecked="{x:Bind ViewModel.ImportFormulas, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowImportFormulas, Mode=OneWay}" />
                    <NumberBox Header="导出工作表（0 全部，其他为表序号）" Minimum="0" Value="{x:Bind ViewModel.Sheet, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowSheet, Mode=OneWay}" SpinButtonPlacementMode="Compact" />
                    <CheckBox Content="导出公式（不选则导出计算结果）" IsChecked="{x:Bind ViewModel.ExportFormulas, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowSheet, Mode=OneWay}" />
                </StackPanel>
            </StackPanel></ContentControl>

                </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ConversionNote, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" />
                    </StackPanel>
                </Expander>
                <TextBlock Text="{x:Bind ViewModel.Feedback, Mode=OneWay}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" AutomationProperties.Name="转换反馈" />
                <Button Content="查看本次输出" Command="{x:Bind ViewModel.ShowOutputsCommand}" Visibility="{x:Bind ViewModel.HasOutputs, Mode=OneWay}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource WorkspaceSurfaceBrush}" Padding="20,14,20,18">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.ScopeSummary, Mode=OneWay}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" ToolTipService.ToolTip="软件文件夹会展开并去重。未选择文件时，使用当前软件文件夹及子文件夹的全部输入。" />
                <Button Command="{x:Bind ViewModel.RunCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="38" AutomationProperties.Name="开始转换">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="开始转换" FontSize="12" FontWeight="SemiBold" /><FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="14" />
                    </Grid>
                </Button>
                <Button Content="取消" Command="{x:Bind ViewModel.CancelCommand}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
