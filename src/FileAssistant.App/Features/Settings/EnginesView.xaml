<UserControl x:Class="FileAssistant.App.Features.Settings.EnginesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:engine="using:FileAssistant.Core.Engines">
    <Grid Margin="24,12,24,20" RowSpacing="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="引擎管理" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="预览和格式转换均在本机处理。" Foreground="{ThemeResource WorkspaceSecondaryBrush}"/>
        <ListView x:Name="EngineList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Engines}" SelectionMode="None" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate><DataTemplate x:DataType="engine:ProcessingEngineInfo">
                <Border Padding="18" Margin="0,4" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource WorkspaceSurfaceBrush}">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{x:Bind StatusLabel}" Foreground="{ThemeResource WorkspaceAccentBrush}" VerticalAlignment="Center"/></StackPanel>
                        <TextBlock Text="{x:Bind Capabilities}"/>
                        <TextBlock Text="{x:Bind Version}" Style="{StaticResource WorkspaceCaptionStyle}"/>
                        <TextBlock Text="{x:Bind Location}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource WorkspaceCaptionStyle}"/>
                    </StackPanel>
                </Border>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="图片与音视频引擎随软件提供。文档引擎按需下载，安装后可在本机转换。" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}"/>
            <TextBlock Text="{x:Bind ViewModel.DownloadDescription}" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="下载或修复视频引擎" Command="{x:Bind ViewModel.DownloadVideoCommand}"/><Button Content="取消下载" Command="{x:Bind ViewModel.CancelCommand}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/><Button Content="重新检查" Command="{x:Bind ViewModel.RefreshCommand}"/></StackPanel>
            <TextBlock Text="{x:Bind ViewModel.OfficeDownloadDescription}" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}"/>
            <Button Content="下载或修复文档引擎" Command="{x:Bind ViewModel.DownloadOfficeCommand}" />
            <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.Feedback, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
    </Grid>
</UserControl>
