<UserControl
    x:Class="FileAssistant.App.Features.Search.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileAssistant.App.Features.Search"
    xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:preview="using:FileAssistant.App.Features.Preview">
    <UserControl.Resources>
        <Style x:Key="SearchColumnHeaderButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource WorkspaceSecondaryBrush}" />
        </Style>
    </UserControl.Resources>
    <UserControl.KeyboardAccelerators><KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" /></UserControl.KeyboardAccelerators>
    <Grid x:Name="SearchLayout" Margin="24,12,24,20" RowSpacing="14">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactSearch">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SearchLayout.Margin" Value="16,12,16,16" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideSearch"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1140" /></VisualState.StateTriggers></VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="搜索与筛选" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="找到文件后可加入暂存区，供需要的功能使用。" Foreground="{ThemeResource WorkspaceSecondaryBrush}" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <controls:ThemeSelectionDropDown />
                <Button Content="文件暂存区" Click="Workspace_Click" ToolTipService.ToolTip="查看已暂存的文件" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="164" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <controls:SelectionDropDown x:Name="ScopeBox" HorizontalAlignment="Stretch" ItemsSource="{x:Bind local:SearchFilterOptions.Scopes}"
                SelectedValue="{x:Bind ViewModel.ScopeIndex, Mode=TwoWay}" AutomationProperties.Name="搜索范围" />
            <TextBox x:Name="QueryBox" Grid.Column="1" MaxLength="2048" PlaceholderText="搜索名称，或输入 ext:jpg;png  size:>2mb" Text="{x:Bind ViewModel.QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextCompositionStarted="Query_CompositionStarted" TextCompositionEnded="Query_CompositionEnded" AutomationProperties.Name="搜索文件名或表达式">
                <TextBox.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Invoked="Refresh_Invoked" /></TextBox.KeyboardAccelerators>
            </TextBox>
            <Button Grid.Column="2" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="刷新结果；指定目录将重新扫描" AutomationProperties.Name="刷新搜索"><FontIcon Glyph="&#xE72C;" FontSize="16" /></Button>
            <Button Grid.Column="3" Command="{x:Bind ViewModel.CancelCommand}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" ToolTipService.ToolTip="取消本次查询" AutomationProperties.Name="取消搜索"><FontIcon Glyph="&#xE711;" FontSize="14" /></Button>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="10">
            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsFolderScope, Mode=OneWay}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" PlaceholderText="输入或选择文件夹路径" Text="{x:Bind ViewModel.Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索文件夹路径" />
                <Button Grid.Column="1" Content="选择文件夹" Click="Browse_Click" />
                <CheckBox Grid.Column="2" Content="包含子目录" IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}" />
            </Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:SelectionDropDown ItemsSource="{x:Bind local:SearchFilterOptions.Kinds}" SelectedValue="{x:Bind ViewModel.KindIndex, Mode=TwoWay}" AutomationProperties.Name="搜索类型" />
                    <controls:SelectionDropDown ItemsSource="{x:Bind local:SearchFilterOptions.Sizes}" SelectedValue="{x:Bind ViewModel.SizeIndex, Mode=TwoWay}" AutomationProperties.Name="文件大小条件" />
                    <controls:SelectionDropDown ItemsSource="{x:Bind local:SearchFilterOptions.Dates}" SelectedValue="{x:Bind ViewModel.DateIndex, Mode=TwoWay}" MinWidth="136" AutomationProperties.Name="修改日期条件" />
                    <CheckBox Content="匹配完整路径" IsChecked="{x:Bind ViewModel.MatchPath, Mode=TwoWay}" Margin="4,0" />
                    <Button Content="常用条件" ToolTipService.ToolTip="保存或套用范围、关键词、筛选和排序">
                        <Button.Flyout><Flyout Placement="Bottom"><StackPanel Width="336" Spacing="12">
                            <TextBlock Text="常用搜索条件" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <controls:SelectionDropDown ItemsSource="{x:Bind ViewModel.PresetOptions}" SelectedValue="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch" AutomationProperties.Name="套用常用条件" />
                                <Button Grid.Column="1" Content="移除" Command="{x:Bind ViewModel.RemovePresetCommand}" IsEnabled="{x:Bind ViewModel.CanRemovePreset, Mode=OneWay}" ToolTipService.ToolTip="只移除保存的条件，不影响文件或当前搜索" />
                            </Grid>
                            <TextBox Header="保存当前条件" PlaceholderText="条件名称，如：本周大图片" MaxLength="60"
                                Text="{x:Bind ViewModel.PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="保存范围、关键词、筛选和排序；不保存搜索结果或所选文件。" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" />
                            <Button Content="保存当前条件" Command="{x:Bind ViewModel.SavePresetCommand}" HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind ViewModel.PresetMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel></Flyout></Button.Flyout>
                    </Button>
                    <Button ToolTipService.ToolTip="支持的搜索语法" AutomationProperties.Name="搜索语法帮助">
                        <FontIcon Glyph="&#xE897;" FontSize="16" />
                        <Button.Flyout><Flyout><StackPanel MaxWidth="340" Spacing="10">
                            <TextBlock Text="常用搜索表达式" FontWeight="SemiBold" />
                            <TextBlock Text="产品 主图　同时包含两个词&#x0a;ext:jpg;png　按扩展名&#x0a;size:>100mb　按大小&#x0a;dm:today / dm:7days　修改日期&#x0a;!备份　排除名称&#x0a;*.pdf | *.docx　任一种匹配&#x0a;file: / folder:　文件或文件夹" TextWrapping="Wrap" FontSize="13" />
                            <TextBlock Text="含空格的名称可加双引号。三个搜索范围使用相同语法；暂不支持内容搜索和正则。" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" />
                        </StackPanel></Flyout></Button.Flyout>
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Visibility="{x:Bind ViewModel.IsCustomSize, Mode=OneWay}" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="大小区间" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13" />
                    <TextBox Width="136" MaxLength="32" PlaceholderText="最小值（不限）" AutomationProperties.Name="最小文件大小"
                        Text="{x:Bind ViewModel.CustomMinimum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="至" VerticalAlignment="Center" />
                    <TextBox Width="136" MaxLength="32" PlaceholderText="最大值（不限）" AutomationProperties.Name="最大文件大小"
                        Text="{x:Bind ViewModel.CustomMaximum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:SelectionDropDown ItemsSource="{x:Bind local:SearchFilterOptions.SizeUnits}" SelectedValue="{x:Bind ViewModel.SizeUnitIndex, Mode=TwoWay}" AutomationProperties.Name="大小单位" />
                    <TextBlock Text="含边界 · 1 MB = 1024 KB" Style="{StaticResource WorkspaceCaptionStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Visibility="{x:Bind ViewModel.IsCustomDate, Mode=OneWay}" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="修改日期" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13" />
                    <CalendarDatePicker Width="160" MinWidth="0" PlaceholderText="开始日期（不限）" DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                        Date="{x:Bind ViewModel.CustomDateFrom, Mode=TwoWay}" AutomationProperties.Name="开始日期" />
                    <Button Tag="From" Click="ClearDate_Click" AutomationProperties.Name="清空开始日期" ToolTipService.ToolTip="清空开始日期" Padding="6"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button>
                    <TextBlock Text="至" VerticalAlignment="Center" />
                    <CalendarDatePicker Width="160" MinWidth="0" PlaceholderText="结束日期（不限）" DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                        Date="{x:Bind ViewModel.CustomDateThrough, Mode=TwoWay}" AutomationProperties.Name="结束日期" />
                    <Button Tag="Through" Click="ClearDate_Click" AutomationProperties.Name="清空结束日期" ToolTipService.ToolTip="清空结束日期" Padding="6"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button>
                    <TextBlock Text="包含结束日期全天" Style="{StaticResource WorkspaceCaptionStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </ScrollViewer>
            <TextBlock Text="{x:Bind ViewModel.FilterError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasFilterError, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" FontSize="13" AutomationProperties.LiveSetting="Polite" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasPreferencesError, Mode=OneWay}" IsClosable="False" Severity="Warning" Message="{x:Bind ViewModel.PreferencesError, Mode=OneWay}">
                <InfoBar.ActionButton><Button Content="重试保存" Command="{x:Bind ViewModel.SavePreferencesCommand}" /></InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
        <Border Grid.Row="3" Background="{ThemeResource WorkspaceSurfaceBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="10">
            <controls:ResizablePane x:Name="DetailsHost" PaneWidth="264" IsPaneOpen="{x:Bind ViewModel.ShowDetails, Mode=TwoWay}">
                <controls:ResizablePane.MainContent>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="12,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <controls:SelectionDropDown Width="160" HorizontalAlignment="Left" ItemsSource="{x:Bind local:SearchFilterOptions.Sorts}"
                            SelectedValue="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" AutomationProperties.Name="搜索结果排序" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="清空" Command="{x:Bind ViewModel.ResetFiltersCommand}" AutomationProperties.Name="清空搜索条件" ToolTipService.ToolTip="清空搜索文字和筛选条件，恢复当前范围的全部结果。" />
                            <ToggleButton x:Name="DetailsToggle" Content="侧栏" IsChecked="{x:Bind ViewModel.ShowDetails, Mode=TwoWay}" AutomationProperties.Name="显示或收起文件信息侧栏" ToolTipService.ToolTip="显示或收起文件信息侧栏" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition x:Name="ResultsHeaderRow" Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <ScrollViewer x:Name="ResultsViewport" Grid.RowSpan="2" SizeChanged="ResultsViewport_SizeChanged" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <Grid MinWidth="{x:Bind ViewModel.ColumnWidths.MinimumTableWidth, Mode=OneWay}" Width="{Binding ViewportWidth, ElementName=ResultsViewport}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border x:Name="ResultsHeader" SizeChanged="ResultsHeader_SizeChanged" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,1" Padding="12,9">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind ViewModel.ColumnWidths.Name, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                            <ColumnDefinition Width="{x:Bind ViewModel.ColumnWidths.Location, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                            <ColumnDefinition Width="{x:Bind ViewModel.ColumnWidths.Size, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                            <ColumnDefinition Width="{x:Bind ViewModel.ColumnWidths.Modified, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                        </Grid.ColumnDefinitions>
                                        <Button Tag="0" Click="SortHeader_Click" Style="{StaticResource SearchColumnHeaderButton}" AutomationProperties.Name="{x:Bind ViewModel.NameSortDescription, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.NameSortDescription, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="名称" /><FontIcon Glyph="{x:Bind ViewModel.NameSortGlyph, Mode=OneWay}" FontSize="10" /></StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Tag="1" Click="SortHeader_Click" Style="{StaticResource SearchColumnHeaderButton}" AutomationProperties.Name="{x:Bind ViewModel.PathSortDescription, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.PathSortDescription, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="所在位置" /><FontIcon Glyph="{x:Bind ViewModel.PathSortGlyph, Mode=OneWay}" FontSize="10" /></StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Tag="2" Click="SortHeader_Click" Style="{StaticResource SearchColumnHeaderButton}" AutomationProperties.Name="{x:Bind ViewModel.SizeSortDescription, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.SizeSortDescription, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="大小" /><FontIcon Glyph="{x:Bind ViewModel.SizeSortGlyph, Mode=OneWay}" FontSize="10" /></StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Tag="3" Click="SortHeader_Click" Style="{StaticResource SearchColumnHeaderButton}" AutomationProperties.Name="{x:Bind ViewModel.ModifiedSortDescription, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.ModifiedSortDescription, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="修改时间" /><FontIcon Glyph="{x:Bind ViewModel.ModifiedSortGlyph, Mode=OneWay}" FontSize="10" /></StackPanel>
                                        </Button>
                                        <controls:ResizeHandle Tag="Name" Style="{StaticResource ColumnResizeHandle}" AutomationProperties.Name="调整名称列宽" ToolTipService.ToolTip="拖动调整名称列宽" ResizeRequested="Column_ResizeRequested" />
                                        <controls:ResizeHandle Grid.Column="1" Tag="Location" Style="{StaticResource ColumnResizeHandle}" AutomationProperties.Name="调整所在位置列宽" ToolTipService.ToolTip="拖动调整所在位置列宽" ResizeRequested="Column_ResizeRequested" />
                                        <controls:ResizeHandle Grid.Column="2" Tag="Size" Style="{StaticResource ColumnResizeHandle}" AutomationProperties.Name="调整大小列宽" ToolTipService.ToolTip="拖动调整大小列宽" ResizeRequested="Column_ResizeRequested" />
                                        <controls:ResizeHandle Grid.Column="3" Tag="Modified" Style="{StaticResource ColumnResizeHandle}" AutomationProperties.Name="调整修改时间列宽" ToolTipService.ToolTip="拖动调整修改时间列宽" ResizeRequested="Column_ResizeRequested" />
                                    </Grid>
                                </Border>
                                <ListView x:Name="ResultsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False" IsEnabled="{x:Bind ViewModel.CanUseResults, Mode=OneWay}"
                                    SelectionChanged="Results_SelectionChanged" ContextRequested="Results_ContextRequested" DoubleTapped="Results_DoubleTapped" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="搜索结果列表">
                                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="40" /><Setter Property="Padding" Value="12,0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style></ListView.ItemContainerStyle>
                                    <ListView.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="A" Modifiers="Control" ScopeOwner="{x:Bind ResultsList}" Invoked="SelectAll_Invoked" />
                                        <KeyboardAccelerator Key="Enter" ScopeOwner="{x:Bind ResultsList}" Invoked="Open_Invoked" />
                                    </ListView.KeyboardAccelerators>
                                    <ListView.ItemTemplate><DataTemplate x:DataType="local:SearchResultItem">
                                        <Grid ColumnSpacing="12" Padding="0,8" ToolTipService.ToolTip="{x:Bind FullPath}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind Columns.Name, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                                <ColumnDefinition Width="{x:Bind Columns.Location, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                                <ColumnDefinition Width="{x:Bind Columns.Size, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                                <ColumnDefinition Width="{x:Bind Columns.Modified, Mode=OneWay, Converter={StaticResource ColumnWidth}}" />
                                            </Grid.ColumnDefinitions>
                                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="17" Foreground="{ThemeResource WorkspaceAccentBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Directory}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource WorkspaceSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel}" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind ModifiedLabel}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </ScrollViewer>
                        <ScrollViewer x:Name="EmptyStateViewport" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}">
                        <StackPanel Spacing="8" MaxWidth="380" Margin="20,12" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                        </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer x:Name="ErrorStateViewport" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{x:Bind ViewModel.ShowSearchError, Mode=OneWay}">
                        <StackPanel Spacing="10" MaxWidth="400" Margin="20,16" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontSize="32" Foreground="{ThemeResource WorkspaceAccentBrush}" />
                            <TextBlock Text="搜索未完成" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Button Content="重试搜索" Command="{x:Bind ViewModel.RefreshCommand}" />
                                <Button Content="选择目录搜索" Click="FolderScope_Click" />
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <StackPanel Grid.Row="3">
                    <InfoBar IsOpen="{x:Bind ViewModel.ShowInlineError, Mode=OneWay}" IsClosable="False" Severity="Warning" Margin="12,8,12,0"
                        Title="{x:Bind ViewModel.InlineErrorTitle, Mode=OneWay}" Message="{x:Bind ViewModel.Message, Mode=OneWay}">
                        <InfoBar.ActionButton><Button Content="重试" Command="{x:Bind ViewModel.RetryCommand}" /></InfoBar.ActionButton>
                    </InfoBar>
                    <Grid Padding="12,8" ColumnSpacing="8" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ResultCountLabel, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="全选仅限已加载项（Ctrl+A）" FontSize="12" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{x:Bind ViewModel.LoadMoreLabel, Mode=OneWay}" Command="{x:Bind ViewModel.LoadMoreCommand}" IsEnabled="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}" ToolTipService.ToolTip="每次加载 200 项；Ctrl+A 只选择已载入项" />
                    </Grid>
                    </StackPanel>
                </Grid>
                </controls:ResizablePane.MainContent>
                <controls:ResizablePane.PaneContent>
                <Border Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1,0,0,0" CornerRadius="0,10,10,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="18" Spacing="18">
                            <TextBlock Text="文件信息" FontWeight="SemiBold" />
                            <preview:FilePreviewView File="{x:Bind ViewModel.SelectedItem.File, Mode=OneWay}" Glyph="{x:Bind ViewModel.DetailGlyph, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.DetailName, Mode=OneWay}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.DetailType, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}" />
                                <StackPanel Spacing="4"><TextBlock Text="大小" Style="{StaticResource WorkspaceCaptionStyle}" /><TextBlock Text="{x:Bind ViewModel.DetailSize, Mode=OneWay}" /></StackPanel>
                                <StackPanel Spacing="4"><TextBlock Text="修改时间" Style="{StaticResource WorkspaceCaptionStyle}" /><TextBlock Text="{x:Bind ViewModel.DetailModified, Mode=OneWay}" FontSize="13" /></StackPanel>
                                <StackPanel Spacing="6"><TextBlock Text="完整路径" Style="{StaticResource WorkspaceCaptionStyle}" /><TextBlock Text="{x:Bind ViewModel.DetailPath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" /></StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                </controls:ResizablePane.PaneContent>
            </controls:ResizablePane>
        </Border>
        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{x:Bind ViewModel.Feedback, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceAccentBrush}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <Button Grid.Column="1" Content="加入文件暂存区" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.CanAdd, Mode=OneWay}" Click="Add_Click" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
