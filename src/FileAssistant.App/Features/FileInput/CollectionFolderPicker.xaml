<UserControl x:Class="FileAssistant.App.Features.FileInput.CollectionFolderPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:workspace="using:FileAssistant.App.Features.Workspace">
    <StackPanel Spacing="10" MinWidth="320">
        <TextBlock Text="加入位置" Style="{StaticResource WorkspaceCaptionStyle}" />
        <Border Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource WorkspaceAccentBrush}" />
                <TextBlock x:Name="TargetPath" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="目标位置" />
                <Button x:Name="ChangeButton" Grid.Column="2" Content="更改" Click="Change_Click" AutomationProperties.Name="更改目标文件夹" />
            </Grid>
        </Border>
        <StackPanel x:Name="TreeRegion" Spacing="6" Visibility="Collapsed">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="选择文件夹" VerticalAlignment="Center" Style="{StaticResource WorkspaceCaptionStyle}" />
                <Button Grid.Column="1" Content="新建文件夹" Click="NewFolder_Click" />
            </Grid>
            <TreeView x:Name="Folders" MaxHeight="200" SelectionMode="Single" SelectionChanged="Folders_SelectionChanged" CanDragItems="False" CanReorderItems="False" AutomationProperties.Name="目标文件夹目录树">
                <TreeView.ItemTemplate><DataTemplate x:DataType="TreeViewNode">
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource WorkspaceAccentBrush}" />
                        <TextBlock Text="{x:Bind ((workspace:FolderBreadcrumb)Content).Name}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate></TreeView.ItemTemplate>
            </TreeView>
            <StackPanel x:Name="NameEditor" Spacing="8" Visibility="Collapsed">
                <TextBox x:Name="NewName" PlaceholderText="文件夹名称" MaxLength="120" KeyDown="NewName_KeyDown" AutomationProperties.Name="新文件夹名称" />
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="创建" Click="Create_Click"/><Button Content="取消新建" Click="CancelNew_Click"/></StackPanel>
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="Message" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" />
    </StackPanel>
</UserControl>
