<UserControl
    x:Class="FileAssistant.App.Features.FileInput.FileInputView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileAssistant.App.Features.Workspace"
    xmlns:input="using:FileAssistant.Core.Features.FileInput"
    xmlns:controls="using:FileAssistant.App.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="StagingItemTemplate" x:DataType="local:WorkspaceFile">
            <StackPanel Spacing="4" Padding="4,6">
                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind FullPath}" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ImportResultTemplate" x:DataType="input:FileImportItem">
            <StackPanel Spacing="4" Padding="4,8">
                <TextBlock Text="{x:Bind StatusLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WorkspaceLayout.Margin" Value="16,12,16,16" />
                        <Setter Target="InspectorColumn.Width" Value="280" />
                        <Setter Target="HeaderSubtitle.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1140" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WorkspaceLayout.Margin" Value="24,12,24,20" />
                        <Setter Target="InspectorColumn.Width" Value="304" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
            <Grid x:Name="WorkspaceLayout" Margin="24,12,24,20" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="HeaderSubtitle" Text="{x:Bind ViewModel.BatchSummary, Mode=OneWay}" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <controls:ThemeSelectionDropDown x:Name="ThemeButton" />
                        <DropDownButton Content="界面示例" AutomationProperties.Name="界面示例" Visibility="{x:Bind ViewModel.IsStaging, Mode=OneWay}">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="载入示例文件" Command="{x:Bind ViewModel.LoadSamplesCommand}" />
                                    <MenuFlyoutItem Text="查看加载状态" Command="{x:Bind ViewModel.LoadSamplesCommand}" CommandParameter="slow" />
                                    <MenuFlyoutItem Text="查看错误状态" Command="{x:Bind ViewModel.ShowErrorCommand}" />
                                    <MenuFlyoutItem Text="查看任务进度" Command="{x:Bind ViewModel.ShowTaskExampleCommand}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="清空暂存区" Command="{x:Bind ViewModel.ClearCommand}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="紧凑窗口" Tag="compact" Click="WindowSize_Click" />
                                    <MenuFlyoutItem Text="标准窗口" Tag="standard" Click="WindowSize_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索当前列表中的名称或路径" QueryIcon="Find"
                        TextChanged="SearchBox_TextChanged" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                        AutomationProperties.Name="搜索当前文件列表" IsEnabled="{x:Bind ViewModel.CanEditList, Mode=OneWay}" />
                    <Border Grid.Column="1" Padding="12,6" CornerRadius="4" Background="{ThemeResource WorkspaceAccentSubtleBrush}"
                        Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.BatchOrigin, Mode=OneWay}" Foreground="{ThemeResource WorkspaceAccentBrush}" FontSize="12" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="{ThemeResource WorkspaceSurfaceBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="10"
                    AllowDrop="True" DragOver="Files_DragOver" Drop="Files_Drop">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="InspectorColumn" Width="304" /></Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="16,14" ColumnSpacing="8" RowSpacing="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" Grid.ColumnSpan="2">
                                    <DropDownButton Content="添加" IsEnabled="{x:Bind ViewModel.CanReceiveFiles, Mode=OneWay}" AutomationProperties.Name="添加文件或文件夹">
                                        <DropDownButton.Flyout><MenuFlyout>
                                            <MenuFlyoutItem Text="选择文件…" Click="PickFiles_Click" />
                                            <MenuFlyoutItem Text="选择文件夹…" Click="PickFolder_Click" />
                                            <MenuFlyoutItem Text="从搜索结果添加…" Click="FindFiles_Click" Visibility="{x:Bind ViewModel.IsStaging, Mode=OneWay}" />
                                        </MenuFlyout></DropDownButton.Flyout>
                                    </DropDownButton>
                                    <Button Content="粘贴" Click="Paste_Click" IsEnabled="{x:Bind ViewModel.CanReceiveFiles, Mode=OneWay}" ToolTipService.ToolTip="粘贴复制的文件，或每行一个完整路径（Ctrl+V）" />
                                    <DropDownButton Content="用于功能" Visibility="{x:Bind ViewModel.IsStaging, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanExportAll, Mode=OneWay}">
                                        <DropDownButton.Flyout><MenuFlyout>
                                            <MenuFlyoutItem Text="{x:Bind ViewModel.SendSelectedLabel, Mode=OneWay}" Click="SendSelected_Click" IsEnabled="{x:Bind ViewModel.CanExportSelection, Mode=OneWay}" />
                                            <MenuFlyoutItem Text="{x:Bind ViewModel.SendAllLabel, Mode=OneWay}" Click="SendAll_Click" />
                                        </MenuFlyout></DropDownButton.Flyout>
                                    </DropDownButton>
                                    <Button Content="从暂存区导入" Click="ImportFromStaging_Click" Visibility="{x:Bind ViewModel.IsFunctionInput, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanReceiveFiles, Mode=OneWay}" />
                                    <Button Content="加入暂存区" Click="AddToStaging_Click" Visibility="{x:Bind ViewModel.IsFunctionInput, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanExportSelection, Mode=OneWay}" ToolTipService.ToolTip="将选中文件加入全局暂存区，供其他功能复用" />
                                </StackPanel>
                                <controls:SelectionDropDown Grid.Row="1" HorizontalAlignment="Left" MinWidth="112"
                                    ItemsSource="{x:Bind local:WorkspaceSelectionOptions.Types}" SelectedValue="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanEditList, Mode=OneWay}" AutomationProperties.Name="文件类型筛选" />
                                <Button Grid.Row="1" Grid.Column="1" Content="清空" Command="{x:Bind ViewModel.ClearCommand}" IsEnabled="{x:Bind ViewModel.CanEditList, Mode=OneWay}"
                                    ToolTipService.ToolTip="只清空当前列表，不删除磁盘文件。" />
                            </Grid>
                            <Border Grid.Row="1" Padding="20,9" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="文件名 / 所在位置" Style="{StaticResource WorkspaceCaptionStyle}" Margin="34,0,0,0" />
                                    <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource WorkspaceCaptionStyle}" />
                                    <TextBlock Grid.Column="2" Text="大小" HorizontalAlignment="Right" Style="{StaticResource WorkspaceCaptionStyle}" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2">
                                <ListView x:Name="FileList" ItemsSource="{x:Bind ViewModel.VisibleFiles}" SelectionMode="Extended"
                                    IsMultiSelectCheckBoxEnabled="True" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}"
                                    SelectionChanged="FileList_SelectionChanged" Margin="4,6" Visibility="{x:Bind ViewModel.ShowList, Mode=OneWay}"
                                    ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    AutomationProperties.Name="待处理文件列表">
                                    <ListView.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="A" Modifiers="Control" ScopeOwner="{x:Bind FileList}" Invoked="SelectAll_Invoked" />
                                        <KeyboardAccelerator Key="Delete" ScopeOwner="{x:Bind FileList}" Invoked="Remove_Invoked" />
                                    </ListView.KeyboardAccelerators>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:WorkspaceFile">
                                            <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind FullPath}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="24" Foreground="{ThemeResource WorkspaceAccentBrush}" />
                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind Directory}" TextTrimming="CharacterEllipsis" Style="{StaticResource WorkspaceCaptionStyle}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Type}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel Spacing="14" Margin="32" MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="48" Foreground="{ThemeResource WorkspaceAccentBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.InputDescription, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                    <Button Content="选择文件" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,6,0,0" Click="PickFiles_Click" />
                                    <TextBlock Text="{x:Bind ViewModel.InputHint, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="12" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.ShowNoResults, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                    <TextBlock Text="没有匹配的文件" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="试试其他关键词，或清除筛选条件。" Foreground="{ThemeResource WorkspaceSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                    <Button Content="清除筛选" HorizontalAlignment="Center" Command="{x:Bind ViewModel.ResetFiltersCommand}" />
                                </StackPanel>
                                <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                                    <ProgressRing Width="36" Height="36" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Foreground="{ThemeResource WorkspaceAccentBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.LoadingMessage, Mode=OneWay}" FontSize="18" />
                                    <Button Content="取消加载" HorizontalAlignment="Center" Command="{x:Bind ViewModel.CancelLoadingCommand}" />
                                </StackPanel>
                                <StackPanel Spacing="14" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE783;" FontSize="36" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="暂时无法加载文件" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                                    <TextBlock Text="错误状态示例：文件可能已移动或无法访问。&#x0a;可重试，或返回原列表。" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <Button Content="重试示例" Command="{x:Bind ViewModel.LoadSamplesCommand}" />
                                        <Button Content="返回列表" Command="{x:Bind ViewModel.DismissErrorCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="3" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.ListSummary, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="移出列表" FontSize="12" Padding="10,5" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" Click="Remove_Click" ToolTipService.ToolTip="只移出列表，不删除文件。" />
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Column="1" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1,0,0,0" Background="{ThemeResource WorkspaceSubtleBrush}" CornerRadius="0,10,10,0">
                            <local:FileInspector x:Name="Inspector" ViewModel="{x:Bind ViewModel}" />
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="3" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasInputFeedback, Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.InputFeedback, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                    <Button Grid.Column="1" Content="查看明细" Click="ImportDetails_Click" Visibility="{x:Bind ViewModel.HasImportDetails, Mode=OneWay}" FontSize="12" />
                </Grid>
                <local:WorkspaceTaskPanel Grid.Row="4" ViewModel="{x:Bind TaskViewModel}" />
            </Grid>
    </Grid>
</UserControl>
