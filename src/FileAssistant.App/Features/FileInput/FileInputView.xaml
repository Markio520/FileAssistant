<UserControl
    x:Class="FileAssistant.App.Features.FileInput.FileInputView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileAssistant.App.Features.Workspace"
    xmlns:input="using:FileAssistant.Core.Features.FileInput"
    xmlns:inputView="using:FileAssistant.App.Features.FileInput"
    xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:preview="using:FileAssistant.App.Features.Preview">
    <UserControl.Resources>
        <inputView:FileInputColumnWidths x:Key="FileColumns" />
        <DataTemplate x:Key="StagingItemTemplate" x:DataType="local:WorkspaceFile">
            <StackPanel Spacing="4" Padding="4,6">
                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind FullPath}" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ImportResultTemplate" x:DataType="input:FileImportItem">
            <StackPanel Spacing="4" Padding="4,8">
                <TextBlock Text="{x:Bind StatusLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}" />
            </StackPanel>
        </DataTemplate>

<DataTemplate x:Key="FileTableTemplate" x:DataType="local:WorkspaceFile">
                                            <Grid ColumnSpacing="12" Background="Transparent" ToolTipService.ToolTip="{x:Bind FullPath}" Tag="{x:Bind}"
                                                AllowDrop="True" DragOver="Row_DragOver" DragLeave="Row_DragLeave" Drop="Row_Drop">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Name, Source={StaticResource FileColumns}, Converter={StaticResource ColumnWidth}}" />
                                                    <ColumnDefinition Width="{Binding Type, Source={StaticResource FileColumns}, Converter={StaticResource ColumnWidth}}" />
                                                    <ColumnDefinition Width="{Binding Size, Source={StaticResource FileColumns}, Converter={StaticResource ColumnWidth}}" />
                                                </Grid.ColumnDefinitions>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="24" Foreground="{ThemeResource WorkspaceAccentBrush}" />
                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind Directory}" TextTrimming="CharacterEllipsis" Style="{StaticResource WorkspaceCaptionStyle}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Type}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
        <ItemsPanelTemplate x:Key="FileTablePanel"><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="FileTilePanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="220" ItemHeight="192" /></ItemsPanelTemplate>
        <DataTemplate x:Key="FileTileTemplate" x:DataType="local:WorkspaceFile">
            <Grid Background="Transparent" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind FullPath}"
                AllowDrop="True" DragOver="Row_DragOver" DragLeave="Row_DragLeave" Drop="Row_Drop">
                <Grid.RowDefinitions><RowDefinition Height="126" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <preview:FileThumbnail File="{x:Bind Source}" Glyph="{x:Bind Glyph}" />
                <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" Margin="5,9,5,3" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="5,0,5,7">
                    <TextBlock Text="{x:Bind Type}" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind SizeLabel}" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="WorkspaceLayout" Margin="24,18,24,12" RowSpacing="18" SizeChanged="WorkspaceLayout_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="WorkspaceHeader" MinHeight="46" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Width="1" Height="22" Background="{ThemeResource WorkspaceBorderBrush}" />
                <TextBlock x:Name="HeaderSubtitle" Text="{x:Bind ViewModel.ListSummary, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}" VerticalAlignment="Center" />
                <Border Background="{ThemeResource WorkspaceAccentSubtleBrush}" CornerRadius="5" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="270" />
                </Border>
                <TextBlock Text="示例" Visibility="{x:Bind ViewModel.HasSamples, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
<controls:ActionDropDown Content="界面示例" AutomationProperties.Name="界面示例" Visibility="{x:Bind ViewModel.IsStaging, Mode=OneWay}">
                            <controls:ActionDropDown.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="载入示例文件" Command="{x:Bind ViewModel.LoadSamplesCommand}" />
                                    <MenuFlyoutItem Text="查看加载状态" Command="{x:Bind ViewModel.LoadSamplesCommand}" CommandParameter="slow" />
                                    <MenuFlyoutItem Text="查看错误状态" Command="{x:Bind ViewModel.ShowErrorCommand}" />
                                    <MenuFlyoutItem Text="查看任务进度" Command="{x:Bind ViewModel.ShowTaskExampleCommand}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="清空当前软件文件夹的引用" Click="Clear_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="紧凑窗口" Tag="compact" Click="WindowSize_Click" />
                                    <MenuFlyoutItem Text="标准窗口" Tag="standard" Click="WindowSize_Click" />
                                </MenuFlyout>
                            </controls:ActionDropDown.Flyout>
                        </controls:ActionDropDown>
                <controls:AddFilesButton FilesRequested="PickFiles_Click" FolderRequested="PickFolder_Click" IsEnabled="{x:Bind ViewModel.CanReceiveFiles, Mode=OneWay}" />
            </StackPanel>
        </Grid>
        <Grid x:Name="ListHeightHost" Grid.Row="1" SizeChanged="ListHeightHost_SizeChanged">
            <Grid.RowDefinitions><RowDefinition x:Name="ListHeightRow" Height="*" /><RowDefinition Height="12" /><RowDefinition x:Name="ListRemainderRow" Height="0" /></Grid.RowDefinitions>
            <controls:ResizablePane x:Name="DetailsHost" PaneSpacing="20" MinimumContentWidth="536" AllowDrop="True" DragOver="Files_DragOver" Drop="Files_Drop">
                <controls:ResizablePane.MainContent>
                    <Border Style="{StaticResource WorkspaceSurfaceStyle}">
                        <Grid x:Name="InputSurface" SizeChanged="InputSurface_SizeChanged">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="FoldersColumn" Width="176" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid x:Name="FolderSidebar" Padding="10,12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Margin="8,0,0,12" ColumnSpacing="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="当前输入" Style="{StaticResource WorkspaceCaptionStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Click="FolderUp_Click" Visibility="{x:Bind ViewModel.CanGoUp, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}" Style="{StaticResource WorkspaceIconButtonStyle}" AutomationProperties.Name="返回上一级软件文件夹" ToolTipService.ToolTip="返回上一级"><FontIcon Glyph="&#xE74A;" FontSize="14" /></Button>
                                    <Button Grid.Column="2" Style="{StaticResource WorkspaceIconButtonStyle}" Click="CollapseFolders_Click" AutomationProperties.Name="收起左侧栏" ToolTipService.ToolTip="收起左侧栏"><PathIcon Width="16" Height="16" Data="F0 M1,2 H15 V14 H1 Z M2,3 V13 H5 V3 Z M6,3 V13 H14 V3 Z" /></Button>
                                </Grid>
                                <Grid x:Name="FolderTreeArea" Grid.Row="1" Background="Transparent" ContextRequested="FolderTree_ContextRequested" AllowDrop="True"
                                    DragEnter="FolderTree_DragOver" DragOver="FolderTree_DragOver" Drop="FolderTree_Drop" DragLeave="FolderTree_DragLeave">
                                    <TreeView x:Name="FolderTree" SelectionMode="Single" SelectionChanged="FolderTree_SelectionChanged"
                                        CanDragItems="True" CanReorderItems="False" AllowDrop="True"
                                        DragItemsStarting="FolderTree_DragItemsStarting" DragItemsCompleted="FolderTree_DragItemsCompleted"
                                        ItemContainerStyle="{StaticResource WorkspaceFolderTreeItemStyle}" AutomationProperties.Name="软件文件夹导航"
                                        AutomationProperties.HelpText="拖到文件夹可变为子文件夹，拖到全部文件或空白处可移到顶层；右键可新建文件夹">
                                        <TreeView.ItemTemplate><DataTemplate x:DataType="TreeViewNode">
                                            <Grid ColumnSpacing="6" ToolTipService.ToolTip="{x:Bind ((local:FolderNavigationItem)Content).Name, Mode=OneWay}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ((local:FolderNavigationItem)Content).Name, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind ((local:FolderNavigationItem)Content).Count, Mode=OneWay}" FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate></TreeView.ItemTemplate>
                                    </TreeView>
                                </Grid>
                            </Grid>
                            <StackPanel x:Name="CollapsedFolders" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,12,0,0" Spacing="12">
                                <Button Style="{StaticResource WorkspaceIconButtonStyle}" Click="ExpandFolders_Click" AutomationProperties.Name="展开左侧栏" ToolTipService.ToolTip="展开左侧栏"><PathIcon Width="16" Height="16" Data="F0 M1,2 H15 V14 H1 Z M2,3 V13 H5 V3 Z M6,3 V13 H14 V3 Z" /></Button>
                                <Button Click="FolderUp_Click" Visibility="{x:Bind ViewModel.CanGoUp, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}" Style="{StaticResource WorkspaceIconButtonStyle}" AutomationProperties.Name="返回上一级软件文件夹" ToolTipService.ToolTip="返回上一级"><FontIcon Glyph="&#xE74A;" FontSize="14" /></Button>
                                <TextBlock Text="文&#x0a;件&#x0a;夹" TextAlignment="Center" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1,0,0,0">
                                <controls:MarqueeSelection Target="{x:Bind FileList}" SelectionCommitted="Files_MarqueeCommitted">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid x:Name="FilesToolbar" Margin="18,14,18,14" SizeChanged="FilesToolbar_SizeChanged">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid x:Name="FolderIdentity" MaxWidth="200" VerticalAlignment="Center" ColumnSpacing="7">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE8B7;" FontSize="17" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                            <TextBlock x:Name="CurrentFolderTitle" Grid.Column="1" Text="全部文件" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind ViewModel.CurrentFolderPath, Mode=OneWay}" />
                                            <TextBlock Grid.Column="2" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" VerticalAlignment="Center"><Run Text="{x:Bind ViewModel.VisibleFiles.Count, Mode=OneWay}" /><Run Text=" 项" /></TextBlock>
                                        </Grid>
                                        <controls:FilterSearchBox x:Name="FilterSearch" Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                                            controls:MarqueeSelection.IsExcluded="True"
                                            ItemsSource="{x:Bind local:WorkspaceSelectionOptions.Types}" SelectedValue="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}"
                                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditList, Mode=OneWay}" />
                                        <StackPanel x:Name="ViewActions" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border x:Name="ActionsDivider" Width="1" Height="20" Margin="0,0,5,0" Background="{ThemeResource WorkspaceBorderBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <ToggleButton x:Name="ListModeButton" Width="32" Click="ListMode_Click" Style="{StaticResource WorkspaceNavigationButtonStyle}" Padding="7" AutomationProperties.Name="列表视图" ToolTipService.ToolTip="列表视图"><FontIcon Glyph="&#xEA37;" FontSize="15" /></ToggleButton>
                                                <ToggleButton x:Name="TileModeButton" Width="32" Click="TileMode_Click" Style="{StaticResource WorkspaceNavigationButtonStyle}" Padding="7" AutomationProperties.Name="缩略图视图" ToolTipService.ToolTip="缩略图视图"><FontIcon Glyph="&#xF0E2;" FontSize="15" /></ToggleButton>
                                            </StackPanel>
                                            <Button Content="从暂存区导入" Click="ImportFromStaging_Click" Visibility="{x:Bind ViewModel.IsFunctionInput, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanReceiveFiles, Mode=OneWay}" MinHeight="32" Padding="10,5" FontSize="12" />
                                            <controls:ActionDropDown Content="用于功能" MinWidth="96" FontSize="12" Visibility="{x:Bind ViewModel.IsStaging, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanExportAll, Mode=OneWay}">
                                                <controls:ActionDropDown.Flyout><MenuFlyout>
                                                    <MenuFlyoutItem Text="{x:Bind ViewModel.SendSelectedLabel, Mode=OneWay}" Click="SendSelected_Click" IsEnabled="{x:Bind ViewModel.CanExportSelection, Mode=OneWay}" />
                                                    <MenuFlyoutItem Text="{x:Bind ViewModel.SendAllLabel, Mode=OneWay}" Click="SendAll_Click" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="{x:Bind ViewModel.SendSelectedToConversionLabel, Mode=OneWay}" Click="ConvertSelected_Click" IsEnabled="{x:Bind ViewModel.CanExportSelection, Mode=OneWay}" />
                                                    <MenuFlyoutItem Text="{x:Bind ViewModel.SendAllToConversionLabel, Mode=OneWay}" Click="ConvertAll_Click" />
                                                </MenuFlyout></controls:ActionDropDown.Flyout>
                                            </controls:ActionDropDown>
                                            <controls:ActionDropDown Content="{x:Bind ViewModel.OperationMenuLabel, Mode=OneWay}" MinWidth="78" FontSize="12" AutomationProperties.Name="列表操作" ToolTipService.ToolTip="{x:Bind ViewModel.InputFeedback, Mode=OneWay}">
                                                <controls:ActionDropDown.Flyout><MenuFlyout>
                                                    <MenuFlyoutItem Text="添加文件夹…" Click="PickFolder_Click" IsEnabled="{x:Bind ViewModel.CanReceiveFiles, Mode=OneWay}" />
                                                    <MenuFlyoutItem Text="从搜索结果添加…" Click="FindFiles_Click" />
                                                    <MenuFlyoutItem Text="加入暂存区…" Click="AddToStaging_Click" Visibility="{x:Bind ViewModel.IsFunctionInput, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanExportSelection, Mode=OneWay}" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="撤销上一步" Command="{x:Bind ViewModel.UndoCommand}" KeyboardAcceleratorTextOverride="Ctrl+Z" />
                                                    <MenuFlyoutItem Text="查看操作明细…" Click="ImportDetails_Click" IsEnabled="{x:Bind ViewModel.HasFooterMessage, Mode=OneWay}" />
                                                    <MenuFlyoutItem Text="重试保存" Click="RetrySave_Click" Visibility="{x:Bind ViewModel.CanRetrySave, Mode=OneWay}" />
                                                    <MenuFlyoutItem Text="重新检查文件状态" Click="RefreshReferences_Click" IsEnabled="{x:Bind ViewModel.CanEditList, Mode=OneWay}" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="清空当前文件夹" Click="Clear_Click" IsEnabled="{x:Bind ViewModel.CanEditList, Mode=OneWay}" />
                                                </MenuFlyout></controls:ActionDropDown.Flyout>
                                            </controls:ActionDropDown>
                                        </StackPanel>
                                    </Grid>
                            <Grid Grid.Row="1" Background="Transparent" RightTapped="Files_RightTapped">
                                <Grid.ContextFlyout><MenuFlyout Opening="CollectionMenu_Opening" MenuFlyoutPresenterStyle="{StaticResource ActionDropDownPresenterStyle}" /></Grid.ContextFlyout>
                                <Grid.RowDefinitions><RowDefinition x:Name="FilesHeaderRow" Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <ScrollViewer x:Name="FilesViewport" Grid.RowSpan="2" SizeChanged="FilesViewport_SizeChanged"
                                    HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                <Grid x:Name="TableContent" Width="{Binding ViewportWidth, ElementName=FilesViewport}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border x:Name="FilesHeader" controls:MarqueeSelection.IsExcluded="True" SizeChanged="FilesHeader_SizeChanged" Padding="18,9" Background="{ThemeResource WorkspaceSubtleBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Name, Source={StaticResource FileColumns}, Converter={StaticResource ColumnWidth}}" />
                                        <ColumnDefinition Width="{Binding Type, Source={StaticResource FileColumns}, Converter={StaticResource ColumnWidth}}" />
                                        <ColumnDefinition Width="{Binding Size, Source={StaticResource FileColumns}, Converter={StaticResource ColumnWidth}}" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="文件名 / 所在位置" Style="{StaticResource WorkspaceCaptionStyle}" Margin="40,0,0,0" />
                                    <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource WorkspaceCaptionStyle}" />
                                    <TextBlock Grid.Column="2" Text="大小" Style="{StaticResource WorkspaceCaptionStyle}" />
                                    <controls:ResizeHandle Tag="Name" Style="{StaticResource ColumnResizeHandle}" ResizeRequested="Column_ResizeRequested" AutomationProperties.Name="调整文件名与所在位置列宽" ToolTipService.ToolTip="拖动调整文件名与所在位置列宽" />
                                    <controls:ResizeHandle Grid.Column="1" Tag="Type" Style="{StaticResource ColumnResizeHandle}" ResizeRequested="Column_ResizeRequested" AutomationProperties.Name="调整类型列宽" ToolTipService.ToolTip="拖动调整类型列宽" />
                                    <controls:ResizeHandle Grid.Column="2" Tag="Size" Style="{StaticResource ColumnResizeHandle}" ResizeRequested="Column_ResizeRequested" AutomationProperties.Name="调整大小列宽" ToolTipService.ToolTip="拖动调整大小列宽" />
                                </Grid>
                            </Border>
                                <ListView x:Name="FileList" ItemTemplate="{StaticResource FileTableTemplate}" SizeChanged="FileList_SizeChanged" Grid.Row="1" ItemsSource="{x:Bind ViewModel.VisibleFiles}" SelectionMode="Extended"
                                    IsMultiSelectCheckBoxEnabled="True" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}"
                                    SelectionChanged="FileList_SelectionChanged" Margin="4,6" Visibility="{x:Bind ViewModel.ShowList, Mode=OneWay}"
                                    KeyDown="Files_KeyDown" CanDragItems="True" CanReorderItems="False"
                                    DragItemsStarting="Files_DragItemsStarting" DragItemsCompleted="Files_DragItemsCompleted"
                                    ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    AutomationProperties.Name="待处理文件列表" AutomationProperties.HelpText="从空白处拖动可框选文件，按住 Ctrl 或 Shift 可追加选择，Esc 取消框选">
                                    <ListView.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="A" Modifiers="Control" ScopeOwner="{x:Bind FileList}" Invoked="SelectAll_Invoked" />
                                        <KeyboardAccelerator Key="Delete" ScopeOwner="{x:Bind FileList}" Invoked="Remove_Invoked" />
                                    </ListView.KeyboardAccelerators>

                                </ListView>
                                </Grid>
                                </ScrollViewer>
                                <ContentControl Grid.Row="1" Style="{StaticResource WorkspaceCenteredStateStyle}" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}">
                                <StackPanel Spacing="14" MaxWidth="360" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="48" Foreground="{ThemeResource WorkspaceAccentBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.InputDescription, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                    <controls:AddFilesButton HorizontalAlignment="Center" Margin="0,6,0,0" FilesRequested="PickFiles_Click" FolderRequested="PickFolder_Click" IsEnabled="{x:Bind ViewModel.CanReceiveFiles, Mode=OneWay}" />
                                </StackPanel>
                                </ContentControl>
                                <ContentControl Grid.Row="1" Style="{StaticResource WorkspaceCenteredStateStyle}" Visibility="{x:Bind ViewModel.ShowNoResults, Mode=OneWay}">
                                <StackPanel Spacing="12" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                    <TextBlock Text="没有匹配的文件" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="试试其他关键词，或清除筛选条件。" Foreground="{ThemeResource WorkspaceSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                    <Button Content="清除筛选" HorizontalAlignment="Center" Command="{x:Bind ViewModel.ResetFiltersCommand}" />
                                </StackPanel>
                                </ContentControl>
                                <ContentControl Grid.Row="1" Style="{StaticResource WorkspaceCenteredStateStyle}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                                <StackPanel Spacing="16" HorizontalAlignment="Center">
                                    <ProgressRing Width="36" Height="36" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Foreground="{ThemeResource WorkspaceAccentBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.LoadingMessage, Mode=OneWay}" FontSize="18" />
                                    <Button Content="取消加载" HorizontalAlignment="Center" Command="{x:Bind ViewModel.CancelLoadingCommand}" />
                                </StackPanel>
                                </ContentControl>
                                <ContentControl Grid.Row="1" Style="{StaticResource WorkspaceCenteredStateStyle}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                                <StackPanel Spacing="14" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE783;" FontSize="36" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="暂时无法加载文件" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                                    <TextBlock Text="错误状态示例：文件可能已移动或无法访问。&#x0a;可重试，或返回原列表。" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <Button Content="重试示例" Command="{x:Bind ViewModel.LoadSamplesCommand}" />
                                        <Button Content="返回列表" Command="{x:Bind ViewModel.DismissErrorCommand}" />
                                    </StackPanel>
                                </StackPanel>
                                </ContentControl>
                            </Grid>
                            <Border Grid.Row="2" controls:MarqueeSelection.IsExcluded="True" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.ListSummary, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="260" Style="{StaticResource WorkspaceCaptionStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="移出列表" FontSize="12" Padding="10,5" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" Click="Remove_Click" ToolTipService.ToolTip="只移出列表，不删除文件。" />
                                </Grid>
                            </Border>
                        </controls:MarqueeSelection>
                            </Border>
                            <controls:ResizeHandle x:Name="FoldersResizeHandle" Grid.Column="1" Width="12" HorizontalAlignment="Left" Margin="-6,0,0,0"
                                ResizeRequested="Folders_ResizeRequested" AutomationProperties.Name="调整左侧文件夹栏宽度"
                                ToolTipService.ToolTip="拖动或使用左右方向键调整文件夹栏宽度" />
                        </Grid>
                    </Border>
                </controls:ResizablePane.MainContent>
                <controls:ResizablePane.PaneContent>
                    <Border Style="{StaticResource WorkspaceSurfaceStyle}" Background="{ThemeResource WorkspaceSubtleBrush}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,0,0,1" Padding="20,8,12,8">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="InspectorTitle" Text="文件信息" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource WorkspaceIconButtonStyle}" Click="CollapseInspector_Click" AutomationProperties.Name="收起右侧栏" ToolTipService.ToolTip="收起右侧栏"><PathIcon Width="16" Height="16" Data="F0 M1,2 H15 V14 H1 Z M2,3 V13 H9 V3 Z M10,3 V13 H14 V3 Z" /></Button>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1"><local:FileInspector x:Name="Inspector" ViewModel="{x:Bind ViewModel}" /><ContentPresenter x:Name="OperationPresenter" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" /></Grid>
                        </Grid>
                    </Border>
                </controls:ResizablePane.PaneContent>
                <controls:ResizablePane.CollapsedPaneContent>
                    <Border Style="{StaticResource WorkspaceSurfaceStyle}"><StackPanel HorizontalAlignment="Center" Margin="0,12,0,0" Spacing="12">
                        <Button Style="{StaticResource WorkspaceIconButtonStyle}" Click="ExpandInspector_Click" AutomationProperties.Name="展开右侧栏" ToolTipService.ToolTip="展开右侧栏"><PathIcon Width="16" Height="16" Data="F0 M1,2 H15 V14 H1 Z M2,3 V13 H9 V3 Z M10,3 V13 H14 V3 Z" /></Button>
                        <TextBlock Text="设&#x0a;置&#x0a;与&#x0a;预&#x0a;览" TextAlignment="Center" FontSize="11" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                    </StackPanel></Border>
                </controls:ResizablePane.CollapsedPaneContent>
            </controls:ResizablePane>
            <controls:ResizeHandle Grid.Row="1" ResizeDirection="Vertical" ResizeRequested="ListHeight_ResizeRequested" DoubleTapped="ListHeight_Reset" AutomationProperties.Name="调整文件列表高度" ToolTipService.ToolTip="上下拖动调整列表高度，双击恢复填满" />
        </Grid>
    </Grid>
</UserControl>
