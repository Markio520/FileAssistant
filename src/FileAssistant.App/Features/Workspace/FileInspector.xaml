<UserControl
    x:Class="FileAssistant.App.Features.Workspace.FileInspector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileAssistant.App.Features.Workspace"
    xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:preview="using:FileAssistant.App.Features.Preview">
    <Pivot x:Name="InspectorTabs" Margin="4,2" AutomationProperties.Name="预览与操作">
        <Pivot.Resources>
            <x:Double x:Key="PivotHeaderItemFontSize">14</x:Double>
        </Pivot.Resources>
        <PivotItem Header="文件信息" Margin="16,6,16,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20">
                    <preview:FilePreviewView File="{x:Bind ViewModel.PreviewFile, Mode=OneWay}" Glyph="{x:Bind ViewModel.PreviewGlyph, Mode=OneWay}" />
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.PreviewName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                            TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.PreviewStatus, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                        <TextBlock Text="在列表中选择文件，查看详细信息。" Visibility="{x:Bind ViewModel.ShowSelectionHint, Mode=OneWay}"
                            FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="18" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <Border Height="1" Background="{ThemeResource WorkspaceBorderBrush}" />
                        <Grid ColumnSpacing="12" RowSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="类型" Style="{StaticResource WorkspaceCaptionStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PreviewType, Mode=OneWay}" FontSize="12" />
                            <TextBlock Grid.Row="1" Text="大小" Style="{StaticResource WorkspaceCaptionStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.PreviewSize, Mode=OneWay}" FontSize="12" />
                            <TextBlock Grid.Row="2" Text="修改时间" Style="{StaticResource WorkspaceCaptionStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.PreviewDate, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />
                        </Grid>
                        <StackPanel Spacing="7">
                            <TextBlock Text="完整路径" Style="{StaticResource WorkspaceCaptionStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PreviewPath, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
        <PivotItem x:Name="ParametersTab" Header="操作参数" Margin="16,6,16,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                <ContentPresenter x:Name="CustomParameters" Visibility="Collapsed" />
                <StackPanel x:Name="CopyParameters" Spacing="22">
                    <StackPanel Spacing="8">
                        <TextBlock Text="复制文件" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="将文件复制到新位置，保留原文件。" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                    </StackPanel>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Header="目标文件夹" PlaceholderText="尚未选择目标位置" IsReadOnly="True" AutomationProperties.Name="目标文件夹，尚未接入" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" IsEnabled="False" AutomationProperties.Name="选择目标文件夹，尚未开放" ToolTipService.ToolTip="目标目录选择将在复制流程中接入。">
                            <FontIcon Glyph="&#xED25;" FontSize="16" />
                        </Button>
                    </Grid>
                    <StackPanel Spacing="8">
                        <TextBlock Text="遇到同名文件" />
                        <controls:SelectionDropDown ItemsSource="{x:Bind local:WorkspaceSelectionOptions.Conflicts}" SelectedValue="0"
                            HorizontalAlignment="Stretch" AutomationProperties.Name="同名文件处理方式" />
                    </StackPanel>
                    <ToggleSwitch Header="保留文件夹结构" OnContent="保留原来的目录层级" OffContent="全部放入目标文件夹" IsOn="True" />
                    <Border Height="1" Background="{ThemeResource WorkspaceBorderBrush}" />
                    <StackPanel Spacing="12">
                        <TextBlock Text="先预览，再执行" Style="{StaticResource WorkspaceSectionStyle}" />
                        <TextBlock Text="开始前核对目标路径与同名文件处理方式。当前为参数界面预览，尚未接入复制。" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" FontSize="13" />
                        <Button Content="预览复制结果" IsEnabled="False" HorizontalAlignment="Stretch" ToolTipService.ToolTip="复制预览与目标目录将在复制流程中接入。" />
                        <Button Content="开始复制" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" HorizontalAlignment="Stretch" ToolTipService.ToolTip="复制执行将在后续步骤接入。" />
                    </StackPanel>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</UserControl>
