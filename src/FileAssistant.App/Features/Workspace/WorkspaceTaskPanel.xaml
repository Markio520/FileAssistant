<UserControl
    x:Class="FileAssistant.App.Features.Workspace.WorkspaceTaskPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource WorkspaceSurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Padding="12,8" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ToggleButton IsChecked="{x:Bind ViewModel.IsQueueExpanded, Mode=TwoWay}" AutomationProperties.Name="展开或收起任务队列">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE9D9;" FontSize="16" /><TextBlock Text="任务队列" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" />
                    </StackPanel>
                </ToggleButton>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TaskSummary, Mode=OneWay}" Foreground="{ThemeResource WorkspaceSecondaryBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Border Grid.Row="1" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,0" Padding="20,16" Visibility="{x:Bind ViewModel.IsQueueExpanded, Mode=OneWay}">
                <Grid>
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.ShowEmptyQueue, Mode=OneWay}">
                        <TextBlock Text="还没有任务" Style="{StaticResource WorkspaceSectionStyle}" />
                        <TextBlock Text="开始批量操作后，可在这里查看进度和处理结果。" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                    </StackPanel>
                    <Grid ColumnSpacing="24" Visibility="{x:Bind ViewModel.IsTaskExample, Mode=OneWay}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="10">
                            <Grid><TextBlock Text="复制到交付目录" FontWeight="SemiBold" /><TextBlock Text="62%" HorizontalAlignment="Right" Foreground="{ThemeResource WorkspaceAccentBrush}" /></Grid>
                            <ProgressBar Value="62" Maximum="100" Foreground="{ThemeResource WorkspaceAccentBrush}" AutomationProperties.Name="示例进度 62%，未执行文件操作" />
                            <TextBlock Text="进度示例 · 5 / 8 项 · 未执行文件操作" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="关闭示例" VerticalAlignment="Center" Command="{x:Bind ViewModel.CloseTaskExampleCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
