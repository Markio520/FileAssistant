<UserControl
    x:Class="FileAssistant.App.Features.Workspace.WorkspaceTaskPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tasks="using:FileAssistant.App.Features.Tasks">
        <Grid Background="{ThemeResource WorkspaceSurfaceBrush}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Padding="16,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="任务队列" Style="{StaticResource WorkspaceSectionStyle}" />
                    <TextBlock Text="{x:Bind Jobs.Summary, Mode=OneWay}" Visibility="{x:Bind Jobs.HasItems, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="关闭" Click="Close_Click" AutomationProperties.Name="关闭任务队列" />
            </Grid>
            <Border Grid.Row="1" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,0" Padding="16">
                <Grid>
                    <Grid Visibility="{x:Bind Jobs.IsEmpty, Mode=OneWay}">
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.ShowEmptyQueue, Mode=OneWay}">
                        <TextBlock Text="还没有任务" Style="{StaticResource WorkspaceSectionStyle}" />
                        <TextBlock Text="开始批量操作后，可在这里查看进度和处理结果。" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                    </StackPanel>
                    <Grid ColumnSpacing="24" Visibility="{x:Bind ViewModel.IsTaskExample, Mode=OneWay}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="10">
                            <Grid><TextBlock Text="复制到交付目录" FontWeight="SemiBold" /><TextBlock Text="62%" HorizontalAlignment="Right" Foreground="{ThemeResource WorkspaceAccentBrush}" /></Grid>
                            <ProgressBar Value="62" Maximum="100" Foreground="{ThemeResource WorkspaceAccentBrush}" AutomationProperties.Name="示例进度 62%，未执行文件操作" />
                            <TextBlock Text="进度示例 · 5 / 8 项 · 未执行文件操作" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="关闭示例" VerticalAlignment="Center" Command="{x:Bind ViewModel.CloseTaskExampleCommand}" />
                    </Grid>
                    </Grid>
                    <ListView ItemsSource="{x:Bind Jobs.Items}" Visibility="{x:Bind Jobs.HasItems, Mode=OneWay}" MaxHeight="240" SelectionMode="None" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate><DataTemplate x:DataType="tasks:ProcessingJob">
                            <StackPanel Spacing="8" Padding="0,4,0,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Status, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource WorkspaceCaptionStyle}"/></StackPanel>
                                    <Button Grid.Column="1" Content="取消" Command="{x:Bind CancelCommand}" Visibility="{x:Bind IsRunning, Mode=OneWay}" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Foreground="{ThemeResource WorkspaceAccentBrush}"/>
                                <Expander Header="处理明细" HorizontalAlignment="Stretch">
                                    <ListView ItemsSource="{x:Bind Details}" MaxHeight="160" SelectionMode="None">
                                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/></DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                </Expander>
                            </StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
</UserControl>
