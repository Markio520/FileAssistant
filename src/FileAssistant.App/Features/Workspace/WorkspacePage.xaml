<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FileAssistant.App.Features.Workspace.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:input="using:FileAssistant.App.Features.FileInput"
    xmlns:search="using:FileAssistant.App.Features.Search"
    xmlns:controls="using:FileAssistant.App.Controls"
    xmlns:convert="using:FileAssistant.App.Features.Convert"
    xmlns:outputs="using:FileAssistant.App.Features.Outputs"
    xmlns:settings="using:FileAssistant.App.Features.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>

        <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False" PaneDisplayMode="Auto" OpenPaneLength="196"
            CompactPaneLength="52" ExpandedModeThresholdWidth="1140" CompactModeThresholdWidth="0"
            AlwaysShowHeader="False" Background="{ThemeResource WorkspaceBackgroundBrush}"
            SelectionChanged="Navigation_SelectionChanged" ItemInvoked="Navigation_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="WorkspaceNavigation" Content="文件暂存区" Tag="workspace" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="OutputsNavigation" Content="文件输出区" Tag="outputs">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="文件操作" />
                <NavigationViewItem x:Name="SearchNavigationItem" Content="搜索与筛选" Tag="search">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="批量创建与改名" IsEnabled="False" ToolTipService.ToolTip="此功能尚未接入。">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8AC;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CopyNavigation" Content="复制与整理" Tag="organize">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ConversionNavigation" Content="格式转换" Tag="convert">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="压缩与解压" IsEnabled="False" ToolTipService.ToolTip="此功能尚未接入。">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xF012;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="核对与清理" IsEnabled="False" ToolTipService.ToolTip="此功能尚未接入。">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="任务队列" Tag="tasks" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
            <input:FileInputView x:Name="StagingPanel" ViewModel="{x:Bind ViewModel}" SearchRequested="Input_SearchRequested" FilesForCopyRequested="Input_FilesForCopyRequested" FilesForConversionRequested="Input_FilesForConversionRequested" />
            <input:FileInputView x:Name="CopyPanel" ViewModel="{x:Bind CopyViewModel}" Visibility="Collapsed" SearchRequested="Input_SearchRequested" />
            <search:SearchView x:Name="SearchPanel" Visibility="Collapsed" WorkspaceRequested="Search_WorkspaceRequested" />
            <convert:ConversionView x:Name="ConversionPanel" Visibility="Collapsed" SearchRequested="Input_SearchRequested" />
            <outputs:OutputsView x:Name="OutputsPanel" Visibility="Collapsed" FilesForConversionRequested="Input_FilesForConversionRequested" FilesForCopyRequested="Input_FilesForCopyRequested" />
            <settings:EnginesView x:Name="SettingsPanel" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
