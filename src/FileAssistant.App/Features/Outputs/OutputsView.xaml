<UserControl x:Class="FileAssistant.App.Features.Outputs.OutputsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileAssistant.App.Features.Outputs" xmlns:workspace="using:FileAssistant.App.Features.Workspace" xmlns:controls="using:FileAssistant.App.Controls">
    <Grid Margin="24,12,24,20" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><TextBlock Text="文件输出区" FontSize="28" FontWeight="SemiBold"/><controls:ThemeSelectionDropDown HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="Query" PlaceholderText="搜索输出文件名或路径" TextChanged="Query_TextChanged" AutomationProperties.Name="搜索输出文件"/>
            <controls:SelectionDropDown Grid.Column="1" ItemsSource="{x:Bind ViewModel.Tasks}" SelectedValue="{x:Bind ViewModel.TaskId, Mode=TwoWay}" AutomationProperties.Name="输出来源任务"/>
        </Grid>
        <Border Grid.Row="2" Background="{ThemeResource WorkspaceSurfaceBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="10">
            <controls:ResizablePane x:Name="DetailsHost" PaneWidth="280">
                <controls:ResizablePane.MainContent>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="打开" Command="{x:Bind ViewModel.OpenCommand}" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"/>
                        <controls:ActionDropDown Content="更多" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"><controls:ActionDropDown.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="打开所在文件夹" Command="{x:Bind ViewModel.RevealCommand}"/>
                            <MenuFlyoutItem Text="复制路径" Command="{x:Bind ViewModel.CopyPathCommand}"/>
                            <MenuFlyoutItem Text="加入暂存区" Click="AddToStaging_Click"/>
                            <MenuFlyoutItem Text="用于格式转换" Click="Convert_Click"/>
                            <MenuFlyoutItem Text="用于复制与整理" Click="Copy_Click"/>
                        </MenuFlyout></controls:ActionDropDown.Flyout></controls:ActionDropDown>
                        <Button Content="清空记录" Command="{x:Bind ViewModel.ClearRecordsCommand}" IsEnabled="{x:Bind ViewModel.HasFiles, Mode=OneWay}" ToolTipService.ToolTip="仅清空记录，磁盘文件保留。"/>
                        </StackPanel>
                        </ScrollViewer>
                        <ToggleButton Grid.Column="1" Content="文件信息" IsChecked="{x:Bind DetailsHost.IsPaneOpen, Mode=TwoWay}" ToolTipService.ToolTip="显示或收起文件信息侧栏"/>
                    </Grid>
                    <ListView x:Name="Files" Grid.Row="1" ItemsSource="{x:Bind ViewModel.VisibleFiles}" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="True"
                        SelectionChanged="Files_SelectionChanged" DoubleTapped="Files_DoubleTapped" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}" Margin="4" AutomationProperties.Name="实际输出文件列表">
                        <ListView.ItemTemplate><DataTemplate x:DataType="local:OutputEntry">
                            <StackPanel Spacing="4" ToolTipService.ToolTip="{x:Bind FullPath}">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind FullPath}" TextTrimming="CharacterEllipsis" Style="{StaticResource WorkspaceCaptionStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind TaskName}" Style="{StaticResource WorkspaceCaptionStyle}"/><TextBlock Text="{x:Bind SizeLabel}" Style="{StaticResource WorkspaceCaptionStyle}"/></StackPanel>
                            </StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1" Text="暂无输出文件" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource WorkspaceSecondaryBrush}"/>
                    <StackPanel Grid.Row="2" Spacing="5" Margin="12"><TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource WorkspaceCaptionStyle}"/><TextBlock Text="{x:Bind ViewModel.Feedback, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"/></StackPanel>
                    <workspace:WorkspaceTaskPanel Grid.Row="3" ViewModel="{x:Bind QueueViewModel}" Margin="8"/>
                </Grid>
                </controls:ResizablePane.MainContent>
                <controls:ResizablePane.PaneContent>
                <Border BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1,0,0,0" Background="{ThemeResource WorkspaceSubtleBrush}" CornerRadius="0,10,10,0">
                    <workspace:FileInspector x:Name="Inspector" ViewModel="{x:Bind ViewModel.Inspector}"/>
                </Border>
                </controls:ResizablePane.PaneContent>
            </controls:ResizablePane>
        </Border>
    </Grid>
</UserControl>
