<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FileAssistant.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FileAssistant.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="文件操作助手"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot" Background="{ThemeResource WorkspaceBackgroundBrush}" ActualThemeChanged="WindowRoot_ActualThemeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="文件操作助手" Height="48">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE8B7;" />
            </TitleBar.IconSource>
        </TitleBar>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
